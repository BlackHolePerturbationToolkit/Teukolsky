Cell[CellGroupData[{

Cell["Satisfying the radial Teukolsky equation numerically", \
"ExampleSubsection",
 CellChangeTimes->{{3.998472000317473*^9, 3.9984720122284813`*^9}},
 CellID->1478359337,ExpressionUUID->"d163e2b0-879a-4757-afd9-0893a251a89b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", 
      RowBox[{"-", "2"}]}], ",", 
     RowBox[{"l", "=", "2"}], ",", 
     RowBox[{"m", "=", "2"}], ",", 
     RowBox[{"a", "=", ".5"}], ",", 
     RowBox[{"\[Omega]", "=", ".2"}], ",", 
     RowBox[{"prec", "=", "200"}], ",", 
     RowBox[{"r", "=", "50"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"aux", ",", "TKR"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"aux", "=", 
       RowBox[{"RadialTeukolskyEquation", "[", 
        RowBox[{"s", ",", "l", ",", "m", ",", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"a", ",", "prec"}], "]"}], ",", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"\[Omega]", ",", "prec"}], "]"}], ",", 
         RowBox[{"R", "[", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{"r", ",", "prec"}], "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"TKR", "=", 
       RowBox[{"TeukolskyRadial", "[", 
        RowBox[{"s", ",", "l", ",", "m", ",", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"a", ",", "prec"}], "]"}], ",", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"\[Omega]", ",", "prec"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aux", "/.", 
       RowBox[{"R", "->", 
        RowBox[{"TKR", "[", "\"\<In\>\"", "]"}]}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.998471856488257*^9, 3.998471971519684*^9}},
 CellLabel->"In[8]:=",
 CellID->2047806222,ExpressionUUID->"8008986b-0063-47c9-8720-976d2ceb51da"],

Cell[BoxData[
 RowBox[{"0``171.52237169413613", "+", 
