Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RadialTeukolskyEquation", "[", 
  RowBox[{"s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", 
   RowBox[{"R", "[", "r", "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.998471826539276*^9, 3.998471840395314*^9}},
 CellLabel->"In[5]:=",
 CellID->1466317967,ExpressionUUID->"a1301c85-cd0e-4daa-94a5-a13221efaa67"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"R", "[", "r", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"4", " ", "\[ImaginaryI]", " ", "r", " ", "s", " ", "\[Omega]"}],
      "+", 
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", "s", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], " ", "m"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["a", "2"], "+", 
             SuperscriptBox["r", "2"]}], ")"}], " ", "\[Omega]"}]}], ")"}]}], 
       "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], " ", "m"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["a", "2"], "+", 
             SuperscriptBox["r", "2"]}], ")"}], " ", "\[Omega]"}]}], ")"}], 
        "2"]}], 
      RowBox[{
       SuperscriptBox["a", "2"], "-", 
       RowBox[{"2", " ", "r"}], "+", 
       SuperscriptBox["r", "2"]}]], "-", 
     InterpretationBox[
      FrameBox[
       RowBox[{
        SubscriptBox["", "s"], 
        SubscriptBox["\[Lambda]", 
         RowBox[{"l", " ", "m"}]], 
        RowBox[{"[", 
         RowBox[{"a", " ", "\[Omega]"}], "]"}]}],
       Background->None,
       FrameMargins->{{0, 1}, {0, 0}},
       FrameStyle->None],
      SpinWeightedSpheroidalHarmonics`SpinWeightedSpheroidalEigenvalue[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`a $CellContext`\
\[Omega]]]}], ")"}]}], "+", 
  RowBox[{"2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "s"}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["R", "\[Prime]",
     MultilineFunction->None], "[", "r", "]"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["a", "2"], "-", 
     RowBox[{"2", " ", "r"}], "+", 
     SuperscriptBox["r", "2"]}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["R", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "r", "]"}]}]}]], "Output",
 CellChangeTimes->{3.998471840690316*^9},
 CellLabel->"Out[5]=",
 CellID->1911744702,ExpressionUUID->"30c829b4-8c84-40b2-87af-427f5a07cbbe"]
}, Open  ]]
}, Open  ]],

