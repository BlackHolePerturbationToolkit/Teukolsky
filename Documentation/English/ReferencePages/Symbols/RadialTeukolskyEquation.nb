Cell["The use of the \[AliasDelimiter]function is straight forward ", \
"ExampleText",
 CellChangeTimes->{{3.980325104589842*^9, 3.980325119142829*^9}, 
   3.98032541125972*^9},
 CellID->37977188,ExpressionUUID->"a30b1b2b-f3a3-4f32-8fd1-7b076fc10273"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RadialTeukolskyEquation", "[", 
  RowBox[{
  "\[ScriptS]", ",", "\[ScriptL]", ",", "\[ScriptM]", ",", "a", ",", 
   "\[Omega]", ",", 
   RowBox[{"R", "[", "r", "]"}]}], "]"}]], "Input",
 CellLabel->"In[40]:=",
 CellID->146366958,ExpressionUUID->"2e9fc5f0-cc16-480e-b2d4-f44af19d04dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"R", "[", "r", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
     "4", " ", "\[ImaginaryI]", " ", "r", " ", "\[ScriptS]", " ", 
      "\[Omega]"}], "+", 
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", "\[ScriptS]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], " ", "\[ScriptM]"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["a", "2"], "+", 
             SuperscriptBox["r", "2"]}], ")"}], " ", "\[Omega]"}]}], ")"}]}], 
       "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], " ", "\[ScriptM]"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["a", "2"], "+", 
             SuperscriptBox["r", "2"]}], ")"}], " ", "\[Omega]"}]}], ")"}], 
        "2"]}], 
      RowBox[{
       SuperscriptBox["a", "2"], "-", 
       RowBox[{"2", " ", "r"}], "+", 
       SuperscriptBox["r", "2"]}]], "-", 
     RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
      RowBox[{"\[ScriptS]", ",", "\[ScriptL]", ",", "\[ScriptM]", ",", 
       RowBox[{"a", " ", "\[Omega]"}]}], "]"}]}], ")"}]}], "+", 
  RowBox[{"2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "\[ScriptS]"}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["R", "\[Prime]",
     MultilineFunction->None], "[", "r", "]"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["a", "2"], "-", 
     RowBox[{"2", " ", "r"}], "+", 
     SuperscriptBox["r", "2"]}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["R", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "r", "]"}]}]}]], "Output",
 CellChangeTimes->{3.980325422733293*^9},
 CellLabel->"Out[40]=",
 CellID->869757993,ExpressionUUID->"22f0ac5c-e2f0-4406-8eab-39d2472f9794"]
}, Open  ]],

Cell["We can use it to check our solutions.", "ExampleText",
 CellChangeTimes->{{3.980325687877522*^9, 3.980325709047464*^9}},
 CellID->831191893,ExpressionUUID->"5f1378c1-2122-46dc-a5b3-888d9c971931"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[ScriptS]", "=", 
      RowBox[{"-", "2"}]}], ",", 
     RowBox[{"\[ScriptL]", "=", "2"}], ",", 
     RowBox[{"\[ScriptM]", "=", "2"}], ",", 
     RowBox[{"a", "=", ".2`64"}], ",", 
     RowBox[{"\[Omega]", "=", 
      FractionBox["1", "1000"]}], ",", 
     RowBox[{"\[ScriptR]", "=", "100"}], ",", 
     RowBox[{"side", "=", "\"\<In\>\""}], ",", "R", ",", "r", ",", "solution",
      ",", "equation"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"equation", "=", 
     RowBox[{"RadialTeukolskyEquation", "[", 
      RowBox[{
      "\[ScriptS]", ",", "\[ScriptL]", ",", "\[ScriptM]", ",", "a", ",", 
       "\[Omega]", ",", 
       RowBox[{"R", "[", "r", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"solution", "=", 
     RowBox[{
      RowBox[{"TeukolskyRadial", "[", 
       RowBox[{
       "\[ScriptS]", ",", "\[ScriptL]", ",", "\[ScriptM]", ",", "a", ",", 
        "\[Omega]"}], "]"}], "[", "side", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"equation", "/.", 
      RowBox[{"R", "->", "solution"}]}], "/.", 
     RowBox[{"r", "->", "\[ScriptR]"}]}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.9803254731583357`*^9, 3.9803256622535152`*^9}, {
  3.9803257283346024`*^9, 3.980325737398439*^9}},
 CellLabel->"In[47]:=",
 CellID->1043392010,ExpressionUUID->"c8a336f3-beda-4eeb-9216-992e7e2f1b7e"],

Cell[BoxData[
 RowBox[{"0``40.628103841336156", "+", 
  RowBox[{"0``40.65760942727079", " ", "\[ImaginaryI]"}]}]], "Output",
 CellChangeTimes->{
  3.9803256847605963`*^9, {3.980325729761607*^9, 3.980325738242168*^9}},
 CellLabel->"Out[47]=",
