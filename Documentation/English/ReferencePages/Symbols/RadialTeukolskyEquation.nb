Cell["\<\
RadialTeukolskyEquation returns the radial Teukolsky equation\
\>", "ExampleText",
 CellChangeTimes->{{3.9980339139122543`*^9, 3.9980339219061947`*^9}},
 CellID->754678522,ExpressionUUID->"81f6f8f9-adcc-417c-9723-1840c61ed888"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RadialTeukolskyEquation", "[", 
  RowBox[{"s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", 
   RowBox[{"R", "[", "r", "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.998033711977668*^9, 3.998033734067472*^9}},
 CellLabel->"In[393]:=",
 CellID->99345493,ExpressionUUID->"0bfecb8a-3cb0-4df7-9f80-81afc21832be"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"R", "[", "r", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"4", " ", "\[ImaginaryI]", " ", "r", " ", "s", " ", "\[Omega]"}],
      "+", 
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", "s", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], " ", "m"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["a", "2"], "+", 
             SuperscriptBox["r", "2"]}], ")"}], " ", "\[Omega]"}]}], ")"}]}], 
       "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], " ", "m"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["a", "2"], "+", 
             SuperscriptBox["r", "2"]}], ")"}], " ", "\[Omega]"}]}], ")"}], 
        "2"]}], 
      RowBox[{
       SuperscriptBox["a", "2"], "-", 
       RowBox[{"2", " ", "r"}], "+", 
       SuperscriptBox["r", "2"]}]], "-", 
     InterpretationBox[
      FrameBox[
       RowBox[{
        SubscriptBox["", "s"], 
        SubscriptBox["\[Lambda]", 
         RowBox[{"l", " ", "m"}]], 
        RowBox[{"[", 
         RowBox[{"a", " ", "\[Omega]"}], "]"}]}],
       Background->None,
       FrameMargins->{{0, 1}, {0, 0}},
       FrameStyle->None],
      SpinWeightedSpheroidalHarmonics`SpinWeightedSpheroidalEigenvalue[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`a $CellContext`\
\[Omega]]]}], ")"}]}], "+", 
  RowBox[{"2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "s"}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["R", "\[Prime]",
     MultilineFunction->None], "[", "r", "]"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["a", "2"], "-", 
     RowBox[{"2", " ", "r"}], "+", 
     SuperscriptBox["r", "2"]}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["R", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "r", "]"}]}]}]], "Output",
 CellChangeTimes->{3.998033734369999*^9},
 CellLabel->"Out[393]=",
 CellID->978646678,ExpressionUUID->"060f07b5-8afc-4e1f-8ca0-12d6f192d219"]
}, Open  ]],

Cell["We can check that it is satisfied numerically ", "ExampleText",
 CellChangeTimes->{{3.998033924246052*^9, 3.998033931711224*^9}},
 CellID->1420858666,ExpressionUUID->"183a3dd2-64b0-460c-b82c-91ca678e5635"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", 
      RowBox[{"-", "2"}]}], ",", 
     RowBox[{"l", "=", "2"}], ",", 
     RowBox[{"m", "=", "2"}], ",", 
     RowBox[{"a", "=", ".4"}], ",", 
     RowBox[{"\[Omega]", "=", ".3"}], ",", 
     RowBox[{"r", "=", "20"}], ",", 
     RowBox[{"prec", "=", "200"}], ",", 
     RowBox[{"sol", "=", "\"\<In\>\""}]}], "}"}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "aux", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"aux", "=", 
       RowBox[{"RadialTeukolskyEquation", "[", 
        RowBox[{"s", ",", "l", ",", "m", ",", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"a", ",", "prec"}], "]"}], ",", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"\[Omega]", ",", "prec"}], "]"}], ",", 
         RowBox[{"R", "[", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{"r", ",", "prec"}], "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aux", "=", 
       RowBox[{"aux", "/.", 
        RowBox[{"R", "->", 
         RowBox[{
          RowBox[{"TeukolskyRadial", "[", 
           RowBox[{"s", ",", "l", ",", "m", ",", 
            RowBox[{"SetPrecision", "[", 
             RowBox[{"a", ",", "prec"}], "]"}], ",", 
            RowBox[{"SetPrecision", "[", 
             RowBox[{"\[Omega]", ",", "prec"}], "]"}]}], "]"}], "[", "sol", 
          "]"}]}]}]}]}]}], "\[IndentingNewLine]", "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.998033739027176*^9, 3.9980338941884747`*^9}},
 CellLabel->"In[398]:=",
 CellID->617728407,ExpressionUUID->"608899b7-ba78-4657-9de1-7284f64c90b3"],

Cell[BoxData[
 RowBox[{"0``174.46926311880114", "+", 
  RowBox[{"0``174.46926332156596", " ", "\[ImaginaryI]"}]}]], "Output",
 CellChangeTimes->{
  3.99803381613111*^9, {3.998033875146668*^9, 3.998033899105932*^9}, 
   3.998033938182226*^9},
 CellLabel->"Out[398]=",
 CellID->1803171813,ExpressionUUID->"4a9b5592-eb96-4bf6-b3b4-4bb2fa4ac4af"]
}, Open  ]]
}, Open  ]],

