Cell["\<\
It can happen that a SeriesData counts in fractions of integer powers, even \
though all of them are 0, which can lead to ill behaviour with, e.g., \
SeriesTake\
\>", "ExampleText",
 CellChangeTimes->{{3.998031959717753*^9, 3.998031964925576*^9}, {
  3.998032013178597*^9, 3.998032038280786*^9}, {3.998032123326185*^9, 
  3.998032136557735*^9}, {3.998032210401575*^9, 3.998032219039583*^9}},
 CellID->259654862,ExpressionUUID->"411bf5ec-99ee-40f4-bb64-0d48f162e729"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"series", "=", 
  RowBox[{"SeriesData", "[", 
   RowBox[{"x", ",", "0", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", 
      RowBox[{"-", "1"}], ",", "0", ",", "1", ",", "0", ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", "0", ",", "8", ",", "2"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9980320963399057`*^9, 3.9980321149949923`*^9}, {
  3.9980323402108994`*^9, 3.998032351328866*^9}},
 CellLabel->"In[341]:=",
 CellID->675535989,ExpressionUUID->"73013abe-86cc-42da-888f-db45a1e92ebb"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"1", "-", "x", "+", 
   SuperscriptBox["x", "2"], "-", 
   SuperscriptBox["x", "3"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "x", "]"}], "4"],
    SeriesData[$CellContext`x, 0, {}, 0, 8, 2],
    Editable->False]}],
  SeriesData[$CellContext`x, 0, {1, 0, -1, 0, 1, 0, -1}, 0, 8, 2],
  Editable->False]], "Output",
 CellChangeTimes->{
  3.99803211521766*^9, {3.998032345586813*^9, 3.998032351984612*^9}},
 CellLabel->"Out[341]=",
 CellID->653568566,ExpressionUUID->"cb502cb6-476c-418f-8bef-45d8afbcb753"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"series", "//", 
  RowBox[{
   RowBox[{"SeriesTake", "[", 
    RowBox[{"#", ",", "3"}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.998032117265933*^9, 3.998032145677063*^9}},
 CellLabel->"In[342]:=",
 CellID->2000509476,ExpressionUUID->"962a3828-a64b-4f50-a335-2c2c971cb796"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"1", "-", "x", "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "x", "]"}], 
     RowBox[{"3", "/", "2"}]],
    SeriesData[$CellContext`x, 0, {}, 0, 3, 2],
    Editable->False]}],
  SeriesData[$CellContext`x, 0, {1, 0, -1}, 0, 3, 2],
  Editable->False]], "Output",
 CellChangeTimes->{3.998032145989705*^9, 3.998032353852652*^9},
