Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"75674ff8-5d85-4f5d-87b1-fbf04384e6c3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PowerCounting",
    BaseStyle->"Link",
    ButtonData->"paclet:TeukolskyPNTools/ref/PowerCounting"], "[", 
   RowBox[{
    StyleBox["series", "TI"], ",", 
    StyleBox["symbol", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "be925d96-6d8f-43b4-83df-61e226bf2472"],
 "\[LineSeparator]replaces the expansion parameter in ",
 Cell[BoxData[
  StyleBox["series", "TI"]], "InlineFormula",ExpressionUUID->
  "67612262-1669-42f7-8ca6-a8d1bef0d9a9"],
 " with ",
 Cell[BoxData[
  StyleBox["symbol", "TI"]], "InlineFormula",ExpressionUUID->
  "2a9bc32b-e0ed-49de-9e9d-a6095b24010b"],
 ". Unlike ",
 Cell[BoxData[
  ButtonBox["ChangeSeriesParameter",
   BaseStyle->"Link",
   ButtonData->"paclet:Teukolsky/ref/ChangeSeriesParameter"]], 
  "InlineFormula",ExpressionUUID->"ac40fbfe-0b0e-4a62-be3c-afa6d29d9892"],
 " it keeps the original expansion parameter as a constant in each \
coefficient."
}], "Usage",
 CellChangeTimes->{{3.997970639856986*^9, 3.9979706399513617`*^9}},
