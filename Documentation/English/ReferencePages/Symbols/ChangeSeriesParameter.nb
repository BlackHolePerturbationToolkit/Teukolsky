Cell["\<\
Replacing the series parameter in a SeriesData object typically leads to \
errors\
\>", "ExampleText",
 CellChangeTimes->{{3.997954759904917*^9, 3.997954776961234*^9}, {
  3.9979548686135807`*^9, 3.997954873897541*^9}},
 CellID->1666570560,ExpressionUUID->"4069fd31-6d31-4df5-a08c-802c9dfe922c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"series", "=", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"1", "+", "x"}]], "//", 
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "10"}], "}"}]}], "]"}], 
    "&"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"series", "/.", 
  RowBox[{"x", "->", 
   RowBox[{"2", "y"}]}]}]}], "Input",
 CellChangeTimes->{{3.997954679096266*^9, 3.997954720978775*^9}, {
  3.99795477856637*^9, 3.997954793465744*^9}},
