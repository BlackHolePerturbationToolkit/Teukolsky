Cell[CellGroupData[{

Cell["10PN time scalings", "ExampleSubsection",
 CellChangeTimes->{{3.959926173081254*^9, 3.959926178720398*^9}},
 CellID->1258072577,ExpressionUUID->"099b861d-3b63-487c-b6bd-db16c7532bca"],

Cell["\<\
To get some idea for the timings we can Table over increasing PN orders. Here \
is an example where we computed the s=-2 \[ScriptL]=2 \[ScriptM]=2 mode from \
1PN (1 term) to 11PN (21 terms).  The timings are given in seconds and we can \
observe an approximate doubling per PN order. When computing very high PN \
orders it is advisable to turn off the \"Simplify\" option.\
\>", "ExampleText",
 CellChangeTimes->{{3.946098215637084*^9, 3.946098229891073*^9}, {
  3.9460983557315197`*^9, 3.9460984598559313`*^9}, {3.946098586832157*^9, 
  3.946098624801135*^9}, {3.955190444074758*^9, 3.955190447480935*^9}, {
  3.980327404576*^9, 3.980327423829571*^9}, {3.980486458877857*^9, 
  3.980486513519287*^9}},
 CellID->1046221386,ExpressionUUID->"912086c4-4ee1-4183-9892-f33c68077427"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"EchoTiming", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"tist", "[", "i", "]"}], "=", 
      RowBox[{"TeukolskyRadialPN", "[", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", 
        ",", 
        RowBox[{"{", 
         RowBox[{"\[Eta]", ",", "i"}], "}"}], ",", 
        RowBox[{"\"\<Simplify\>\"", "->", "False"}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"ToString", "[", 
       FractionBox[
        RowBox[{"i", "-", "1"}], "2"], "]"}], "<>", "\"\<PN\>\""}]}], "]"}], 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "23", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.945694220862994*^9, 3.9456943062972803`*^9}, {
   3.945694341957625*^9, 3.945694367499048*^9}, {3.945694410849701*^9, 
   3.945694453081644*^9}, {3.945694838819032*^9, 3.945694864676091*^9}, {
   3.947076627755723*^9, 3.947076627951153*^9}, {3.9551869749037333`*^9, 
   3.955186992437384*^9}, {3.955187334648843*^9, 3.955187335421009*^9}, 
   3.955190454640034*^9, {3.980326721310273*^9, 3.980326722984923*^9}, 
   3.980329972460667*^9, 3.98033004765905*^9, {3.9804864643693657`*^9, 
   3.9804864764721193`*^9}},
 CellLabel->"In[4]:=",
 CellID->310155003,ExpressionUUID->"c23576aa-c276-4c71-9dc8-a55e676d959d"],

