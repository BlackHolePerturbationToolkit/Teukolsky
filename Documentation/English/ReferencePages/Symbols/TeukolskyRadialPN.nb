Notebook[{

Cell[CellGroupData[{
Cell["TeukolskyRadialPN", "ObjectName",
 CellID->2024991223,ExpressionUUID->"b39a84bd-6e05-45a1-8a43-1f68fc9bf855"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dde4c2fa-3238-4980-ae69-60aeac927121"],
 Cell[BoxData[
  ButtonBox["TeukolskyRadialPN",
   BaseStyle->"Link",
   ButtonData->"paclet:Teukolsky/ref/TeukolskyRadialPN"]], "InlineFormula",
  ExpressionUUID->"e93356a3-251c-421b-93d2-bb22474ce098"],
 "[ ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "4b9b0ffb-ff10-4616-a810-a7aa0b94a6e7"],
 ",",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "3beb5951-99b5-4b6b-bbdf-e57aac77432e"],
 ", ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",ExpressionUUID->
  "4bb305a8-1b12-4a4b-a721-7a92a28a2116"],
 ", ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",ExpressionUUID->
  "822acbab-eb49-4fea-9f5c-fd57466d7f30"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TR"]], "InlineFormula",ExpressionUUID->
  "1919becf-cc86-4226-aff8-54f5cda317e9"],
 ", {",
 Cell[BoxData[
  StyleBox["\[Eta]", "TR"]], "InlineFormula",ExpressionUUID->
  "f3e8e67b-9c62-4685-aa70-497d49cbc4a6"],
 ", ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "f2e7e0a2-4c7c-4131-b818-41f2dbf15663"],
 "}]\[LineSeparator]gives the In and Up solutions to the radial Teukolsky \
equation for a mode ",
 Cell[BoxData[
 "s"], "InlineFormula",ExpressionUUID->"b424e6d3-09f2-4cec-96bf-fc666d2c3071"],
 ", ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "5b8b9221-c82d-4c90-9638-677b59530e85"],
 ", ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",ExpressionUUID->
  "1618b474-ecc7-4880-8077-de938cf9a3a5"],
 ".  ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",ExpressionUUID->
  "477da857-d757-4120-8fe3-094759bf72f7"],
 " is the Kerr spin parameter, ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",ExpressionUUID->
  "3d147233-f501-41ef-8ffd-832693dbd6c4"],
 " is the frequency, ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TR"]], "InlineFormula",ExpressionUUID->
  "da2b011f-b9c1-4dfc-b492-f2d20d0831e3"],
 " is the PN expansion parameter and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "00ea66ec-4eb8-45ea-a8f5-0b9989c8f730"],
 " the number of terms. "
}], "Usage",
 CellChangeTimes->{{3.942146008319547*^9, 3.942146008438014*^9}, {
   3.9422227374162283`*^9, 3.942222782742009*^9}, 3.942222863661958*^9, {
   3.947075682920389*^9, 3.947075683823448*^9}, {3.947427549558626*^9, 
   3.947427549690394*^9}, {3.977120304745329*^9, 3.977120383281654*^9}, {
   3.998131794008272*^9, 3.998131872114887*^9}, 3.998385673367529*^9},
 CellID->1226706735,ExpressionUUID->"860eeef6-58c4-4c2e-ba29-267e4b80d079"],

Cell[TextData[{
 "We compute ",
 Cell[BoxData[
  SubsuperscriptBox["R", "\[ScriptL]\[ScriptM]\[Omega]", "In"]], 
  "InlineFormula",ExpressionUUID->"0ab18874-2e89-4e4c-b1e8-6d614322d6f0"],
 " according to Eq. (147) of [",
 ButtonBox["Sasaki, Tagoshi, Living Rev. Relativity 6",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://www.livingreviews.org/lrr-2003-6"], None}],
 "], modified to divide out a factor of ",
 Cell[BoxData[
  SubscriptBox["K", "\[Nu]"]], "InlineFormula",ExpressionUUID->
  "69332f75-3d13-4104-bcca-63654e495bea"],
 ", i.e., ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["R", "In"], "=", 
   RowBox[{
    SubsuperscriptBox["R", "C", "\[Nu]"], "+", 
    RowBox[{
     FractionBox[
      SubscriptBox["K", 
       RowBox[{
        RowBox[{"-", "\[Nu]"}], "-", "1"}]], 
      SubscriptBox["K", "\[Nu]"]], 
     SubsuperscriptBox["R", "C", 
      RowBox[{
       RowBox[{"-", "\[Nu]"}], "-", "1"}]]}]}]}]], "InlineFormula",
  ExpressionUUID->"22f03afe-7450-4da1-9be5-f80612788075"],
 ".  ",
 Cell[BoxData[
  SubscriptBox["R", "Up"]], "InlineFormula",ExpressionUUID->
  "442a549d-6804-49df-ade2-e854a7ce585d"],
 " is computed using Eq. (B.7) of ",
 ButtonBox["Will Throwe's MSc thesis",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://dspace.mit.edu/handle/1721.1/61270%5D"], None}],
 " modified by a factor of ",
 Cell[BoxData[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], "\[Pi]", 
    RowBox[{"(", 
     RowBox[{"i\[Nu]", "-", "is", "+", 
      RowBox[{"2", "\[CurlyEpsilon]"}]}], ")"}]}]]], "InlineFormula",
  ExpressionUUID->"546c5d9b-1050-4855-afd8-ddb78560bb5b"],
 " ."
}], "Notes",
 CellChangeTimes->{{3.94223010417549*^9, 3.942230142224959*^9}, {
   3.942230254892722*^9, 3.942230470166971*^9}, {3.942230511057706*^9, 
   3.942230554319509*^9}, 3.942230599297515*^9, {3.942230711648521*^9, 
   3.942230712881777*^9}, {3.947074453476533*^9, 3.947074454745444*^9}, {
   3.947075695139953*^9, 3.947075875401649*^9}, {3.998386729111899*^9, 
   3.99838674320389*^9}},
 CellID->1221797685,ExpressionUUID->"9593db7e-87cc-4897-928e-46f72ca9bb38"],

Cell[TextData[{
 "All quantities are treated in units of black hole mass ",
 Cell[BoxData[
  RowBox[{"M", "=", "1"}]], "InlineFormula",ExpressionUUID->
  "7504105c-443c-4016-b4f3-938392d61802"],
 ". The PN scalings are applied as ",
 Cell[BoxData[
  RowBox[{"r", "->", 
   RowBox[{
    SuperscriptBox["\[Eta]", 
     RowBox[{"-", "2"}]], "r"}]}]], "InlineFormula",ExpressionUUID->
  "8b88fe37-c1a8-4d40-acfa-9cc0ecd8cf6b"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[Omega]", "->", 
   RowBox[{
    SuperscriptBox["\[Eta]", "3"], " ", "\[Omega]"}]}]], "InlineFormula",
  ExpressionUUID->"ea28da23-dd0e-4d99-83fb-527c0ad5dfa5"],
 " with ",
 Cell[BoxData[
  RowBox[{"\[Eta]", 
   RowBox[{"<<", "1"}]}]], "InlineFormula",ExpressionUUID->
  "797b181a-450a-47e1-9efe-11ac76ceba08"],
 ". This is motivated by expanding the (at this level not present) source \
around a Keppler orbit where semimajor axis ",
 Cell[BoxData[
  SubscriptBox["r", "0"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "b4bf1b93-c670-4c05-9017-5a9280889b9e"],
 " and orbital frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "f3730b59-f857-4f58-919e-e11b50d89bbe"],
 " are related by  ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["r", "0", 
    RowBox[{"-", "2"}]], "~", 
   SuperscriptBox["\[CapitalOmega]", "3"]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "1c34d4f6-c34d-40d3-888b-4d758060d343"],
 " and demanding ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["r", "0"], ">>", "1"}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "f0cf2d33-ce29-4e36-b930-4b47f7bcbebb"],
 ",  ",
 Cell[BoxData[
  RowBox[{"r", "~", 
   SubscriptBox["r", "0"]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "94d65d49-e694-46b5-b0dc-49f05852d9a0"],
 " ,and ",
 Cell[BoxData[
  RowBox[{"\[Omega]", "~", "\[CapitalOmega]"}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "ce65ab33-5f75-4101-ac09-c6ca1a64a863"],
 ". "
}], "Notes",
 CellChangeTimes->{{3.977122581869439*^9, 3.977122741655292*^9}, {
  3.9771227758330803`*^9, 3.977122799404048*^9}, {3.9771228373543873`*^9, 
  3.977123214414873*^9}, {3.977123328882635*^9, 3.9771233301505327`*^9}},
 CellID->499369057,ExpressionUUID->"78c22dea-3cea-4987-b66a-225fcda3e5da"],

Cell[TextData[{
 Cell[BoxData[
 "\[Eta]"], "InlineFormula",ExpressionUUID->
  "2fb6672c-0ec9-4abe-b524-71d9f53a6b10"],
 "  acts as a PN power counting parameter. When plugging in numerical values \
it can be set to ",
 Cell[BoxData[
  RowBox[{"\[Eta]", "->", "1"}]], "InlineFormula",ExpressionUUID->
  "f8cbf9b5-db4a-47d4-b1df-b1572100134b"],
 ". Furthermore all occurrences of  ",
 Cell[BoxData[
 "\[Eta]"], "InlineFormula",ExpressionUUID->
  "88dbc366-0a54-4ce2-88e6-a55888c7010b"],
 "  within the series coefficients are set to 1 automatically, e.g., Log[r \
\[Omega]] instead of Log[r \[Omega] \[Eta]]. This is to prevent large loading \
times when ex- or importing expressions."
}], "Notes",
 CellChangeTimes->{{3.942231598364758*^9, 3.94223171721447*^9}, {
   3.947089426022648*^9, 3.947089426371539*^9}, 3.97712256799853*^9, {
   3.977123246824904*^9, 3.977123284273242*^9}, {3.977123319666999*^9, 
   3.977123325305479*^9}, {3.977123462394301*^9, 3.977123484971377*^9}, {
   3.977123523779434*^9, 3.977123623200403*^9}, {3.97712371049109*^9, 
   3.977123728963854*^9}},
 CellID->556061698,ExpressionUUID->"67ed3adb-5abb-44c4-8cc0-aad7df587465"],

Cell["The following options can be given: ", "Notes",
 CellID->800012652,ExpressionUUID->"a84acfe8-0383-490c-83e5-f90bde958621"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f5f742c4-36b1-45c2-85ae-fda8a07ad2c1"], "\"\<Normalization\>\"", 
    "\"\<Default\>\"", Cell[TextData[{
     "The normalization for the In and Up solution. The \"Default\" option is \
geared towards efficiency. \"SasakiTagoshi\" multiplies ",
     Cell[BoxData[
      SubsuperscriptBox["R", "\[ScriptL]\[ScriptM]\[Omega]", "In"]], 
      "InlineFormula",ExpressionUUID->"5468c765-b74c-4a29-aa89-90ed3e1455d7"],
     
     " by a factor of ",
     Cell[BoxData[
      SubscriptBox["K", "\[Nu]"]], "InlineFormula",ExpressionUUID->
      "5c72ce0f-5f1c-4f16-bfcc-c3d4d04ec457"],
     ". and ",
     Cell[BoxData[
      SubsuperscriptBox["R", "\[ScriptL]\[ScriptM]\[Omega]", "Up"]], 
      "InlineFormula",ExpressionUUID->"f926bf55-a365-44bf-9deb-7dd39b817c54"],
     
     "by ",
     Cell[BoxData[
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], "\[Pi]", 
        RowBox[{"(", 
         RowBox[{"i\[Nu]", "-", "is", "+", 
          RowBox[{"2", "\[CurlyEpsilon]"}]}], ")"}]}]]], "InlineFormula",
      FormatType->StandardForm,ExpressionUUID->
      "1f1d117d-2267-45a0-a638-5fb87931956a"],
     " \"UnitTransmission\" makes it such that the transmission coefficients \
are 1. This is also the normalization used in ",
     Cell[BoxData[
      ButtonBox["TeukolskyRadial",
       BaseStyle->"Link",
       ButtonData->"paclet:Teukolsky/ref/TeukolskyRadial"]], "InlineFormula",
      ExpressionUUID->"f61d7580-b347-4a03-bc51-33b8be40e4cc"],
     " (no PN). "
    }], "TableText",ExpressionUUID->"2269722d-801c-4e1c-8e5f-1ca23e444c7f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "89c33c48-155f-47e5-a2b9-55326e9185cc"], "\"\<Simplify\>\"", "True", 
    Cell["\<\
Gives the solutions in Simplified form. False will speed up the computation \
time, but increase the ByteCount by about a factor of 10.\
\>", "TableText",ExpressionUUID->"cfe0ac5c-feb3-416e-868e-b6a694e75fbf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "617dfade-53c6-490c-a171-6200e7f44de6"], "\"\<Amplitudes\>\"", "False", 
    Cell["\<\
Determines weather or not to compute the asymptotic Amplitudes.\
\>", "TableText",ExpressionUUID->"b63f291d-862e-4a59-8d20-520c02068359"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "02079e11-77fb-48f5-a5c8-3e4b5a08bf64"], "\"\<CoulombWaveFunctions\>\"", 
    "False", Cell[TextData[{
     "Returns ",
     Cell[BoxData[
      SubsuperscriptBox["R", "C", 
       RowBox[{
        RowBox[{"\[Nu]", "/", 
         RowBox[{"-", "\[Nu]"}]}], "-", "1"}]]], "InlineFormula",
      ExpressionUUID->"8794797a-d319-4ba5-a229-cbca74716d8d"],
     " (instead of  ",
     Cell[BoxData[
      SubscriptBox["R", 
       RowBox[{"In", "/", "Up"}]]], "InlineFormula",ExpressionUUID->
      "12a16d4a-7e07-4732-8f70-57e6d286afc3"],
     " )  corresponing to Sasaki Tagoshi Eq.(162)"
    }], "TableText",ExpressionUUID->"ac1ca6d9-8ce5-4c3f-a7a4-1a945057d58c"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{3.942226969137558*^9, 3.9422269693066587`*^9}, {
   3.942227056880557*^9, 3.942227076988049*^9}, 3.9422271393781767`*^9, {
   3.942227185895194*^9, 3.94222734696238*^9}, {3.942229499518452*^9, 
   3.94222955524142*^9}, {3.942230656164405*^9, 3.94223066232033*^9}, {
   3.942230809279039*^9, 3.942230938905239*^9}, {3.942230975767381*^9, 
   3.942230990215602*^9}, {3.946986561540934*^9, 3.9469865656218557`*^9}, {
   3.947075893567389*^9, 3.947075942085696*^9}, {3.977119856962031*^9, 
   3.977119957019212*^9}, 3.977120057651574*^9, {3.998057552965523*^9, 
   3.998057563645831*^9}, {3.998057601306246*^9, 3.998057656362195*^9}},
 CellID->276668925,ExpressionUUID->"27a68418-637f-4905-991d-718be27b7e20"]
}, Open  ]],

