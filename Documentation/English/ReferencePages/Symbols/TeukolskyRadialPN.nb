          RowBox[{"3", "+", 
           FractionBox[
            RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], 
            SqrtBox[
             RowBox[{"1", "-", 
              SuperscriptBox["a", "2"]}]]]}]}], "]"}]}]}], ")"}]}]}], "+", 
   InterpretationBox[
    SuperscriptBox[
