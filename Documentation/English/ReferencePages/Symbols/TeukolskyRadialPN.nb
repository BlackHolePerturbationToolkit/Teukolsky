Cell["\<\
The \"Normalization\" option changes the normalization of the In and Up \
solutions, i.e., multiplying them by a constant factor. In this context \
constant this means that it does not depend on r. It can however depend on \
\[Omega] and thus carry PN powers. There are three possible options: \
\"SasakiTagoshi\", \"UnitTransmission\", and \"Default\". \"SasakiTagoshi\" \
is the typical normalization from their paper. \
\>", "ExampleText",
 CellChangeTimes->{{3.947137392742113*^9, 3.9471375798594017`*^9}, {
  3.947137612408456*^9, 3.9471376433837976`*^9}, {3.9471377100205717`*^9, 
  3.947137728106756*^9}, {3.947428515920608*^9, 3.947428525571335*^9}},
 CellID->1832956426,ExpressionUUID->"742c2b0e-8f3e-4512-b55a-de194dfe1406"],

Cell[BoxData[
 RowBox[{
  RowBox[{"test", "=", 
   RowBox[{"TeukolskyRadialPN", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", "4"}], "}"}], ",", 
     RowBox[{"\"\<Normalization\>\"", "->", "\"\<SasakiTagoshi\>\""}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.942146703702984*^9, 3.942146722501711*^9}, {
   3.9421467558855658`*^9, 3.942146758339668*^9}, {3.942232068052496*^9, 
