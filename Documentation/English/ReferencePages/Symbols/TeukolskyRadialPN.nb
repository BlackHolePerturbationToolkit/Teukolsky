          RowBox[{"1", "-", 
           SuperscriptBox["a", "2"]}]]}]]}]], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "a"}]], " ", 
     RowBox[{"(", 
      RowBox[{"75", "-", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], "-", 
       RowBox[{"75", " ", 
        SuperscriptBox["a", "2"]}], "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", 
        SuperscriptBox["a", "3"]}], "+", 
