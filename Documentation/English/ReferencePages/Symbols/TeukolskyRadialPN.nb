Cell["\<\
The \"Amplitudes\" option determines wether or not the incidence, \
transmission and reflection amplitudes are computed. Since they have to be \
derived separately this increases the computation time. We thus set the \
default to False.  \
\>", "ExampleText",
 CellChangeTimes->{{3.947139252036683*^9, 3.947139255980721*^9}, {
  3.947139389227869*^9, 3.947139470236415*^9}, {3.947139643061785*^9, 
  3.947139671600875*^9}},
 CellID->240495969,ExpressionUUID->"7c015010-6132-4cda-9be5-6574c07593e2"],

