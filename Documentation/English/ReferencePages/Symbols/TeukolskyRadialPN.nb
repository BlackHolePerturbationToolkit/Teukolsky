Cell[CellGroupData[{

Cell["Checking against numerics", "ExampleSubsection",
 CellChangeTimes->{{3.9599261583999577`*^9, 3.9599261615845003`*^9}, {
  3.959926205371707*^9, 3.9599262064608183`*^9}},
 CellID->1964789488,ExpressionUUID->"8ab31aec-f867-4661-83ce-ba809a597345"],

Cell["\<\
To compare with the numerics we need to set the Normalization option to \
\"UnitTransmission\"! A simple 1.5 PN check already gives reasonable results\
\>", "ExampleText",
 CellChangeTimes->{{3.955186393441285*^9, 3.9551864014463*^9}, {
  3.955186444280965*^9, 3.955186517903098*^9}, {3.955186645069394*^9, 
