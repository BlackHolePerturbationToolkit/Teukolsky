Cell[TextData[{
 "\"UnitTransmission\" scales the solutions in such a way that the \
transmission amplitudes are 1. It is also the normalization used in the \
numerical equivalent ",
 ButtonBox["TeukolskyRadial",
  BaseStyle->"Link",
  ButtonData->"paclet:Teukolsky/ref/TeukolskyRadial"],
 "."
}], "ExampleText",
 CellChangeTimes->{{3.947137749426086*^9, 3.94713782391953*^9}, {
  3.94742870427796*^9, 3.9474287141342297`*^9}},
