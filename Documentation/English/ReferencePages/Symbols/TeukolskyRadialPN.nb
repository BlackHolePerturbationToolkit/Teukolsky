 RowBox[{
  RowBox[{"testN", "=", 
   RowBox[{"TeukolskyRadial", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "2", ",", ".3", ",", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"testPN", "=", 
   RowBox[{"TeukolskyRadialPN", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "2", ",", ".3", ",", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]], ",", 
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", "4"}], "}"}], ",", 
     RowBox[{"\"\<Normalization\>\"", "->", "\"\<UnitTransmission\>\""}]}], 
    "]"}]}], ";"}]}], "Input",
