      Complex[0, 3] $CellContext`a (1 - $CellContext`a^2)^Rational[1, 2])^(-2)
       E^(Complex[0, 2] $CellContext`a (
       Rational[1, 2] + (2 + 2 (1 - $CellContext`a^2)^Rational[1, 2])^(-1) 
        Log[1 - $CellContext`a^2])) 
    Gamma[Complex[0, -2] $CellContext`a (1 - $CellContext`a^2)^
        Rational[-1, 2]]^(-1) 
    Gamma[Complex[0, 2] $CellContext`a (1 - $CellContext`a^2)^
       Rational[-1, 2]] (Complex[0, -2889] $CellContext`a^5 + 
     Complex[0, -963] $CellContext`a^3 (1 - $CellContext`a^2)^Rational[1, 2] + 
     Complex[0, -321] $CellContext`a (-9 + (1 - $CellContext`a^2)^
        Rational[1, 2]) + 963 (1 + (1 - $CellContext`a^2)^Rational[1, 2]) + 
     3 $CellContext`a^4 (-404 + 
       963 (1 - $CellContext`a^2)^Rational[1, 2]) + $CellContext`a^2 (10189 + 
       7704 (1 - $CellContext`a^2)^Rational[1, 2]) + 
     Complex[0, 1926] ($CellContext`a + 3 $CellContext`a^3) 
      PolyGamma[
       0, Complex[0, 2] $CellContext`a (1 - $CellContext`a^2)^
         Rational[-1, 2]])}, -9, 1, 1],
