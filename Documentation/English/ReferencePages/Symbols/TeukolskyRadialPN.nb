      FractionBox[
       RowBox[{"22", " ", 
        SuperscriptBox["r", "6"], " ", 
        SuperscriptBox["\[Omega]", "6"]}], "105"]}], ")"}], " ", 
    SuperscriptBox["\[Eta]", "6"]}], "+", 
   RowBox[{
    FractionBox["2", "105"], " ", 
    SuperscriptBox["r", "4"], " ", 
    SuperscriptBox["\[Omega]", "5"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"56", " ", "a"}], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{"35", "+", 
         RowBox[{"28", " ", 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}]]}], "-", 
         RowBox[{"84", " ", "EulerGamma"}], "-", 
         RowBox[{"3", " ", 
          SuperscriptBox["r", "3"], " ", 
          SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}]}], ")"}], " ", 
    SuperscriptBox["\[Eta]", "7"]}], "+", 
