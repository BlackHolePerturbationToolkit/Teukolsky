Cell["\<\
If the \"Simplify\" option is set to True it performs a Simplify operation \
before finishing. This prolongs computation time but reduces the size of the \
expression. We find that the payoff is usually worth it and thus set it to \
True by default. The following is a 7PN example for illustration\
\>", "ExampleText",
 CellChangeTimes->{{3.947138341737446*^9, 3.947138429604832*^9}, {
  3.955180978311454*^9, 3.955180979089417*^9}, {3.955182232455258*^9, 
  3.955182248545437*^9}},
 CellID->452470426,ExpressionUUID->"fdb8bf99-06d7-4ad5-bd8a-47a4e85b44e3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"EchoTiming", "[", 
   RowBox[{
    RowBox[{"testSimplify", "=", 
     RowBox[{"TeukolskyRadialPN", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
       RowBox[{"{", 
        RowBox[{"\[Eta]", ",", "15"}], "}"}], ",", 
       RowBox[{"\"\<Simplify\>\"", "->", "True"}]}], "]"}]}], ",", 
    "\"\<Timing Simplify True\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EchoTiming", "[", 
   RowBox[{
    RowBox[{"testNoSimplify", "=", 
     RowBox[{"TeukolskyRadialPN", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
       RowBox[{"{", 
        RowBox[{"\[Eta]", ",", "15"}], "}"}], ",", 
       RowBox[{"\"\<Simplify\>\"", "->", "False"}]}], "]"}]}], ",", 
    "\"\<Timing Simplify False\>\""}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.942227414086315*^9, 3.942227440883704*^9}, {
  3.942227495466867*^9, 3.942227498776565*^9}, {3.942227552086349*^9, 
