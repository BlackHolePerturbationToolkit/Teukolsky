        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}]]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "a"}], "+", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}]]}], ")"}], " ", "\[Omega]", " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}]]]}], "]"}], " ", 
     SuperscriptBox["\[Eta]", "9"]}]], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"10", " ", "\[ImaginaryI]", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "a", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          FractionBox[
           RowBox[{"Log", "[", 
            RowBox[{"1", "-", 
             SuperscriptBox["a", "2"]}], "]"}], 
           RowBox[{"2", "+", 
            RowBox[{"2", " ", 
             SqrtBox[
              RowBox[{"1", "-", 
               SuperscriptBox["a", "2"]}]]}]}]]}], ")"}]}]], " ", 
      RowBox[{"Gamma", "[", 
       FractionBox[
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}]]], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2889"}], " ", "\[ImaginaryI]", " ", 
         SuperscriptBox["a", "5"]}], "-", 
        RowBox[{"963", " ", "\[ImaginaryI]", " ", 
         SuperscriptBox["a", "3"], " ", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["a", "2"]}]]}], "-", 
        RowBox[{"321", " ", "\[ImaginaryI]", " ", "a", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "9"}], "+", 
           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["a", "2"]}]]}], ")"}]}], "+", 
        RowBox[{"963", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["a", "2"]}]]}], ")"}]}], "+", 
        RowBox[{"3", " ", 
         SuperscriptBox["a", "4"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "404"}], "+", 
           RowBox[{"963", " ", 
            SqrtBox[
             RowBox[{"1", "-", 
              SuperscriptBox["a", "2"]}]]}]}], ")"}]}], "+", 
        RowBox[{
