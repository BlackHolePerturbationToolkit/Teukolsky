Cell[CellGroupData[{

Cell["Satisfying the Teukolsky equation", "ExampleSubsection",
 CellChangeTimes->{{3.959926134051858*^9, 3.959926139380265*^9}},
 CellID->1795709513,ExpressionUUID->"3a0a1c35-84f8-4382-b9e1-68dfac7d15bb"],

Cell["\<\
To start this example we have to take a look into the hidden toolbox \
Teukolsky`PN`Tools`. What this does is it makes a lot of private functions \
public. We encourage the user to have a look around there, but do warn that \
the documentation is lacking and reserve the right for interface changes.\
\>", "ExampleText",
 CellChangeTimes->{{3.947140139755814*^9, 3.947140305406106*^9}},
 CellID->1347069881,ExpressionUUID->"aece41f8-0562-4d2d-8903-9cb7a9696420"],

Cell[BoxData[
 RowBox[{"<<", "Teukolsky`PN`Tools`"}]], "Input",
 CellChangeTimes->{{3.947140047008301*^9, 3.947140054810024*^9}},
 CellLabel->"In[202]:=",
 CellID->1465869481,ExpressionUUID->"87daf4a0-64f3-4c9f-be04-ade26c9401f7"],

Cell["\<\
One of those functions is TeukolskyEquation which does exactly what you'd \
suspect. \
\>", "ExampleText",
 CellChangeTimes->{{3.947140315623951*^9, 3.947140344951198*^9}, {
  3.947140441542849*^9, 3.9471404512551403`*^9}},
 CellID->696324049,ExpressionUUID->"85a64678-306e-459d-afbb-25541f4c57a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TeukolskyEquation", "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
   RowBox[{"R", "[", "r", "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.947140369617958*^9, 3.9471403760476933`*^9}, {
  3.94714043173141*^9, 3.947140432222985*^9}},
 CellLabel->"In[203]:=",
 CellID->111029699,ExpressionUUID->"a87f1604-e6da-4061-97cc-02f44a9a2301"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"R", "[", "r", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "4"}], " ", "a", " ", "\[Omega]"}], "-", 
     RowBox[{"4", " ", "\[ImaginaryI]", " ", "r", " ", "\[Omega]"}], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"4", " ", 
        SuperscriptBox["a", "2"]}], "-", 
       RowBox[{"8", " ", "\[ImaginaryI]", " ", "a", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "r"}], ")"}]}], "-", 
       RowBox[{"8", " ", "a", " ", "r", " ", "\[Omega]"}], "+", 
       RowBox[{"4", " ", "\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["a", "2"]}], "+", 
          SuperscriptBox["r", "2"]}], ")"}], " ", "\[Omega]"}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["a", "2"], "+", 
           SuperscriptBox["r", "2"]}], ")"}], "2"], " ", 
        SuperscriptBox["\[Omega]", "2"]}]}], 
      RowBox[{
       SuperscriptBox["a", "2"], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", "r"}], ")"}], " ", "r"}]}]], "-", 
     RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "2", ",", "2", ",", 
       RowBox[{"a", " ", "\[Omega]"}]}], "]"}]}], ")"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"2", "-", 
     RowBox[{"2", " ", "r"}]}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["R", "\[Prime]",
     MultilineFunction->None], "[", "r", "]"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["a", "2"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "r"}], ")"}], " ", "r"}]}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["R", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "r", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.947140370111865*^9, 3.9471403797001147`*^9}, 
   3.947140432563583*^9, 3.947430102494678*^9, 3.95518294063312*^9},
 CellLabel->"Out[203]=",
 CellID->2061181675,ExpressionUUID->"fda5edf7-2d9f-4538-ba62-9172cbe92066"]
}, Closed]],

Cell[TextData[{
 "Giving it a PN parameter and scaling leads to a PN expansion. Note that the \
additional ",
 Cell[BoxData[
  SuperscriptBox["\[Eta]", "2"]], "InlineFormula",ExpressionUUID->
  "1f7ab0cf-9fce-4b95-a139-553d11e0a6f3"],
 " scaling coming from the r derivatives is accounted in \
TeukolskyRadialFuncionPN so we leave it out here. "
}], "ExampleText",
 CellChangeTimes->{{3.947140456397105*^9, 3.947140477026095*^9}, {
  3.947140524136005*^9, 3.947140561284075*^9}, {3.947140606937093*^9, 
  3.947140677753032*^9}, {3.947430083432341*^9, 3.9474300899831343`*^9}, {
  3.955185791375126*^9, 3.955185836265016*^9}},
 CellID->1750130442,ExpressionUUID->"f419eacf-c850-4430-b1cd-b2d429fb7b05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TeukolskyEquation", "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
   RowBox[{"{", 
    RowBox[{"\[Eta]", ",", "4"}], "}"}], ",", 
   RowBox[{"R", "[", "r", "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.947140056589113*^9, 3.947140069931404*^9}, {
  3.9471405652113132`*^9, 3.9471406023241873`*^9}, {3.9471411470515356`*^9, 
  3.9471411476006*^9}},
 CellLabel->"In[204]:=",
 CellID->32371201,ExpressionUUID->"3a50e813-a851-4585-9249-1776936e1edb"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["r", "2"], " ", 
     RowBox[{
      SuperscriptBox["R", "\[Prime]\[Prime]",
       MultilineFunction->None], "[", "r", "]"}]}], 
    SuperscriptBox["\[Eta]", "4"]], "+", 
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", "r", " ", 
      RowBox[{
       SuperscriptBox["R", "\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}], "-", 
     RowBox[{"2", " ", "r", " ", 
      RowBox[{
       SuperscriptBox["R", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}]}], 
    SuperscriptBox["\[Eta]", "2"]], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Eta]", "]"}], "0"],
    SeriesData[$CellContext`\[Eta], 0, {}, -4, 0, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Eta], 
   0, {$CellContext`r^2 Derivative[2][$CellContext`R][$CellContext`r], 
    0, (-2) $CellContext`r Derivative[1][$CellContext`R][$CellContext`r] - 
    2 $CellContext`r Derivative[2][$CellContext`R][$CellContext`r]}, -4, 0, 1],
  Editable->False]], "Output",
 CellChangeTimes->{
  3.947140070227069*^9, 3.9471404792416368`*^9, {3.947140569494948*^9, 
   3.947140603165336*^9}, 3.9471407103025846`*^9, 3.947141148065609*^9, 
   3.947430105277457*^9, 3.955182953065003*^9},
 CellLabel->"Out[204]=",
 CellID->1792994043,ExpressionUUID->"5bce0dcb-3fea-447c-a32d-319e3848e531"]
}, Closed]],

Cell["(This can be reverted by the Option \"ScaleR\"->True)", "ExampleText",
 CellChangeTimes->{{3.9551858380426064`*^9, 3.955185841413739*^9}},
 CellID->672879875,ExpressionUUID->"75808f3a-6a5b-44f6-b33c-7a38fe5b4464"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TeukolskyEquation", "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
   RowBox[{"{", 
    RowBox[{"\[Eta]", ",", "2"}], "}"}], ",", 
   RowBox[{"R", "[", "r", "]"}], ",", 
   RowBox[{"\"\<ScaleR\>\"", "->", "True"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.955185820455092*^9, 3.955185828708693*^9}},
 CellLabel->"In[428]:=",
 CellID->1922158694,ExpressionUUID->"c36a7756-fc2f-491f-bc36-bfbaebe9ac61"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "4"}], " ", 
      RowBox[{"R", "[", "r", "]"}]}], "-", 
     RowBox[{"2", " ", "r", " ", 
      RowBox[{
       SuperscriptBox["R", "\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["r", "2"], " ", 
      RowBox[{
       SuperscriptBox["R", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}]}], ")"}], "-", 
   RowBox[{"4", " ", "\[ImaginaryI]", " ", "r", " ", "\[Omega]", " ", 
    RowBox[{"R", "[", "r", "]"}], " ", "\[Eta]"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Eta]", "]"}], "2"],
    SeriesData[$CellContext`\[Eta], 0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Eta], 
   0, {(-4) $CellContext`R[$CellContext`r] - 2 $CellContext`r 
    Derivative[1][$CellContext`R][$CellContext`r] + $CellContext`r^2 
     Derivative[2][$CellContext`R][$CellContext`r], 
    Complex[0, -4] $CellContext`r $CellContext`\[Omega] \
$CellContext`R[$CellContext`r]}, 0, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.9551858241412287`*^9, 3.9551858291266813`*^9}},
 CellLabel->"Out[428]=",
 CellID->877174078,ExpressionUUID->"49db7bf1-2043-4fa6-b59f-cdb9f4b831c5"]
}, Closed]],

Cell["\<\
We can now plug in our solution to see that it indeed satisfies the Teukolsky \
equation to a given PN order. (Running TeukolskyEquation to low orders can \
result in faulty output because of how the Derivative of \
TeukolskyRadialFunctionPN) works \
\>", "ExampleText",
 CellChangeTimes->{{3.94714569400724*^9, 3.94714574232067*^9}, {
  3.955185687280747*^9, 3.9551857735078077`*^9}},
 CellID->557276988,ExpressionUUID->"82d74bf1-73c9-45b3-a9e4-4be477fb7989"],

Cell[BoxData[
 RowBox[{
  RowBox[{"test", "=", 
   RowBox[{"TeukolskyRadialPN", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", "5"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.947140682359414*^9, 3.947140727681944*^9}},
 CellLabel->"In[421]:=",
 CellID->1030004094,ExpressionUUID->"41b6f25e-5d45-4bcc-9be0-866c7a1cdcf3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"TeukolskyEquation", "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
    RowBox[{"{", 
     RowBox[{"\[Eta]", ",", "15"}], "}"}], ",", 
    RowBox[{"R", "[", "r", "]"}]}], "]"}], "/.", 
  RowBox[{"R", "->", 
   RowBox[{"(", 
    RowBox[{"test", "[", "\"\<In\>\"", "]"}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.947140768785646*^9, 3.947140786022345*^9}, {
  3.9471408240187063`*^9, 3.947140869696505*^9}, {3.947141152250727*^9, 
  3.9471411603181868`*^9}, {3.947141194065998*^9, 3.947141201770412*^9}, {
  3.9471456332274857`*^9, 3.9471456395685983`*^9}, {3.955183047802321*^9, 
  3.9551830526933327`*^9}, {3.95518563650696*^9, 3.955185636539069*^9}, {
  3.955185675494384*^9, 3.955185679182522*^9}},
 CellLabel->"In[424]:=",
 CellID->1873637377,ExpressionUUID->"1bd38f9c-1b8a-4067-bd6b-1f1b07a1490f"],

Cell[BoxData[
 InterpretationBox[
  SuperscriptBox[
   RowBox[{"O", "[", "\[Eta]", "]"}], "9"],
  SeriesData[$CellContext`\[Eta], 0, {}, 9, 9, 1],
  Editable->False]], "Output",
