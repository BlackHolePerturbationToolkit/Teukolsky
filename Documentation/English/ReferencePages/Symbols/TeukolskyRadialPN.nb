     RowBox[{"TeukolskyRadialPN", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
       RowBox[{"{", 
        RowBox[{"\[Eta]", ",", "10"}], "}"}]}], "]"}]}], ";"}], ",", 
   "\"\<With Amplitudes\>\""}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"EchoTiming", "[", 
  RowBox[{
   RowBox[{
