    RowBox[{"2", " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "a", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"Log", "[", 
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}], "]"}], 
          RowBox[{"1", "+", 
           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["a", "2"]}]]}]]}], ")"}]}]], " ", 
     SuperscriptBox["r", "5"], " ", "\[Omega]"}], 
    RowBox[{"3", " ", 
     SuperscriptBox["\[Eta]", "7"]}]], "-", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "a", " ", 
