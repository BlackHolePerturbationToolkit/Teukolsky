  RowBox[{
   FractionBox[
    RowBox[{"3", " ", "\[ImaginaryI]"}], 
    RowBox[{"\[Omega]", " ", 
     SuperscriptBox["\[Eta]", "3"]}]], "+", 
   RowBox[{"(", 
