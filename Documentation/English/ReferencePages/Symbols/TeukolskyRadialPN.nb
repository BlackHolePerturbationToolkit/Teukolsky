Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Incidence\"\>", "\[Rule]", 
    InterpretationBox[
     RowBox[{
      FractionBox[
       RowBox[{"3", " ", "\[ImaginaryI]"}], 
       RowBox[{"\[Omega]", " ", 
        SuperscriptBox["\[Eta]", "3"]}]], "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["31", "2"]}], "-", 
        FractionBox[
         RowBox[{"10", " ", "\[ImaginaryI]", " ", "a"}], "3"], "-", 
        RowBox[{"2", " ", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["a", "2"]}]]}], "+", 
        RowBox[{"12", " ", "EulerGamma"}], "-", 
        RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "+", 
        RowBox[{"Log", "[", "4096", "]"}], "+", 
        RowBox[{"6", " ", 
         RowBox[{"Log", "[", "\[Omega]", "]"}]}]}], ")"}], "+", 
      InterpretationBox[
       SuperscriptBox[
        RowBox[{"O", "[", "\[Eta]", "]"}], "1"],
       SeriesData[$CellContext`\[Eta], 0, {}, -3, 1, 1],
       Editable->False]}],
     SeriesData[$CellContext`\[Eta], 0, {
      Complex[0, 3]/$CellContext`\[Omega], 0, 0, Rational[-31, 2] + Complex[0, 
          Rational[-10, 3]] $CellContext`a - 
       2 (1 - $CellContext`a^2)^Rational[1, 2] + 12 EulerGamma + 
       Complex[0, -3] Pi + Log[4096] + 6 Log[$CellContext`\[Omega]]}, -3, 1, 
      1],
     Editable->False]}], ",", 
   RowBox[{"\<\"Transmission\"\>", "\[Rule]", 
    InterpretationBox[
     RowBox[{
      RowBox[{
       FractionBox["4", "5"], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "a", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           FractionBox[
            RowBox[{"Log", "[", 
             RowBox[{"1", "-", 
              SuperscriptBox["a", "2"]}], "]"}], 
            RowBox[{"1", "+", 
             SqrtBox[
              RowBox[{"1", "-", 
               SuperscriptBox["a", "2"]}]]}]]}], ")"}]}]], " ", 
       SuperscriptBox["\[Omega]", "4"], " ", 
       SuperscriptBox["\[Eta]", "12"]}], "+", 
      RowBox[{
       FractionBox["4", "15"], " ", "\[ImaginaryI]", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "a", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           FractionBox[
            RowBox[{"Log", "[", 
             RowBox[{"1", "-", 
              SuperscriptBox["a", "2"]}], "]"}], 
            RowBox[{"1", "+", 
             SqrtBox[
              RowBox[{"1", "-", 
               SuperscriptBox["a", "2"]}]]}]]}], ")"}]}]], " ", 
       SuperscriptBox["\[Omega]", "5"], " ", 
       RowBox[{"(", 
        RowBox[{"3", "+", 
         RowBox[{"7", " ", 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}]]}], "+", 
         RowBox[{"3", " ", 
          RowBox[{"Log", "[", 
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}], "]"}]}], "+", 
         RowBox[{"6", " ", 
          RowBox[{"PolyGamma", "[", 
           RowBox[{"0", ",", 
            RowBox[{"3", "+", 
             FractionBox[
              RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], 
              SqrtBox[
               RowBox[{"1", "-", 
                SuperscriptBox["a", "2"]}]]]}]}], "]"}]}]}], ")"}], " ", 
       SuperscriptBox["\[Eta]", "15"]}], "+", 
      InterpretationBox[
       SuperscriptBox[
        RowBox[{"O", "[", "\[Eta]", "]"}], "16"],
       SeriesData[$CellContext`\[Eta], 0, {}, 12, 16, 1],
       Editable->False]}],
     SeriesData[$CellContext`\[Eta], 0, {
      Rational[4, 5] 
       E^(Complex[0, -1] $CellContext`a (
          1 + (1 + (1 - $CellContext`a^2)^Rational[1, 2])^(-1) 
           Log[1 - $CellContext`a^2])) $CellContext`\[Omega]^4, 0, 0, 
       Complex[0, 
         Rational[4, 15]] 
       E^(Complex[0, -1] $CellContext`a (
          1 + (1 + (1 - $CellContext`a^2)^Rational[1, 2])^(-1) 
           Log[1 - $CellContext`a^2])) $CellContext`\[Omega]^5 (3 + 
        7 (1 - $CellContext`a^2)^Rational[1, 2] + 3 Log[1 - $CellContext`a^2] + 
        6 PolyGamma[
          0, 3 + Complex[0, 2] $CellContext`a (1 - $CellContext`a^2)^
             Rational[-1, 2]])}, 12, 16, 1],
     Editable->False]}], ",", 
   RowBox[{"\<\"Reflection\"\>", "\[Rule]", 
    InterpretationBox[
     RowBox[{
      RowBox[{"-", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", 
        SuperscriptBox["\[Omega]", "3"], " ", 
        SuperscriptBox["\[Eta]", "9"]}]}], "+", 
      RowBox[{
       FractionBox["2", "9"], " ", 
       SuperscriptBox["\[Omega]", "4"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "9"}], "-", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], "+", 
         RowBox[{"6", " ", 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}]]}], "+", 
         RowBox[{"9", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "+", 
         RowBox[{"18", " ", 
          RowBox[{"Log", "[", "2", "]"}]}], "+", 
         RowBox[{"18", " ", 
          RowBox[{"Log", "[", 
           RowBox[{"2", " ", "\[Omega]"}], "]"}]}]}], ")"}], " ", 
