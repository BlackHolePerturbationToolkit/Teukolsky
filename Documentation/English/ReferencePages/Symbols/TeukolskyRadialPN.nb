    SuperscriptBox["\[Eta]", "4"]}], "+", 
   RowBox[{
    FractionBox["8", "15"], " ", "\[ImaginaryI]", " ", 
    SuperscriptBox["r", "5"], " ", 
    SuperscriptBox["\[Omega]", "5"], " ", 
    SuperscriptBox["\[Eta]", "5"]}], "+", 
