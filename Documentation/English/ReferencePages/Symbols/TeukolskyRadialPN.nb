   3.947145627339979*^9, 3.94714564035749*^9}, 3.947145749238254*^9, 
   3.947430134178501*^9, 3.955182972526751*^9, {3.9551830418114767`*^9, 
   3.955183053010536*^9}, {3.955185637041012*^9, 3.95518567962932*^9}},
 CellLabel->"Out[424]=",
 CellID->758197656,ExpressionUUID->"ecc13341-f010-42f9-a9d0-5b1f6030e879"]
}, Closed]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"TeukolskyEquation", "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
