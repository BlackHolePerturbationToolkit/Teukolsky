      RowBox[{
       RowBox[{"-", 
        FractionBox["8", "5"]}], " ", "\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "a"}], ")"}], " ", 
       
       SuperscriptBox["r", "3"], " ", 
