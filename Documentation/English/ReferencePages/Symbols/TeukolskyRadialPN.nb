Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox[
    RowBox[{"90", " ", "\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], "+", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}]]}], ")"}], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "a", " ", 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], "+", 
         FractionBox[
          RowBox[{"Log", "[", 
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}], "]"}], 
          RowBox[{"2", "+", 
           RowBox[{"2", " ", 
            SqrtBox[
             RowBox[{"1", "-", 
              SuperscriptBox["a", "2"]}]]}]}]]}], ")"}]}]], " ", 
     RowBox[{"Gamma", "[", 
      FractionBox[
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], 
