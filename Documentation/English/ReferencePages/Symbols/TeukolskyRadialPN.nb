Cell["\<\
If we continue to go higher we might run into Simplify timeout errors. This \
can be fixed by setting the TimeConstraint Option for Simplify. \
\>", "ExampleText",
 CellChangeTimes->{{3.9460984680468597`*^9, 3.946098558871151*^9}, {
  3.946099061524925*^9, 3.946099078185382*^9}, {3.947076669618264*^9, 
  3.947076674939335*^9}, {3.955190468961535*^9, 3.955190538466524*^9}},
 CellID->279466906,ExpressionUUID->"778f4c57-9bcb-4098-ad19-9a19ef29621e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SetOptions", "[", 
  RowBox[{"Simplify", ",", 
   RowBox[{"TimeConstraint", "->", "1000"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.94584121255661*^9, 3.94584122975668*^9}, {
   3.945841282359701*^9, 3.945841290745599*^9}, {3.946098340464063*^9, 
   3.946098341215021*^9}, 3.955190527960368*^9, {3.998473189597248*^9, 
