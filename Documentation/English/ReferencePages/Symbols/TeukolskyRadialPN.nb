            SqrtBox[
             RowBox[{"1", "-", 
              SuperscriptBox["a", "2"]}]]]}], "]"}]}]}], ")"}]}], ")"}], "/", 
    
    RowBox[{"(", 
     RowBox[{"107", " ", "a", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "a"}], "+", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}]]}], ")"}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"3", " ", 
          SuperscriptBox["a", "2"]}], "+", 
         RowBox[{"3", " ", "\[ImaginaryI]", " ", "a", " ", 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}]]}]}], ")"}], "2"], " ", 
