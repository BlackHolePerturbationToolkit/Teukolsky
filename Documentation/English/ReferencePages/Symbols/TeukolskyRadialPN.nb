     RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", "4"}], "}"}], ",", 
     RowBox[{"\"\<Normalization\>\"", "->", "\"\<UnitTransmission\>\""}], ",", 
     RowBox[{"\"\<Amplitudes\>\"", "->", "True"}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.947137828003072*^9, 3.9471378859437537`*^9}},
