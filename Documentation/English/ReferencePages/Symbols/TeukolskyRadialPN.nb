 CellChangeTimes->{{3.955179988022872*^9, 3.955180026169587*^9}, {
   3.9551802535545807`*^9, 3.9551802789982443`*^9}, 3.9551803511486073`*^9},
 CellID->364496359,ExpressionUUID->"8db60d73-b03d-48f7-8ad3-d86100fa2a66"],

Cell["\<\
\"TermCount\" returns the number of terms in the Series. It should always be \
equivalent to the input. It crucially is not a simple copy of the input and \
acts as a check that no orders got lost during the computation. As we count \
the 0PN leading term as 1 the conversion is xPN <-> 2x+1 terms.\
\>", "ExampleText",
 CellChangeTimes->{{3.9460974455316772`*^9, 3.94609755360815*^9}, {
  3.94609760050492*^9, 3.946097625542478*^9}, {3.947137077790091*^9, 
