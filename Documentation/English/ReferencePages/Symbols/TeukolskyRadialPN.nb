Cell[TextData[{
 "The  \"CoulombWaveFunctions\"  allows to output ",
 Cell[BoxData[
  SubsuperscriptBox["R", "C", "\[Nu]"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "94c15da9-89b5-4d6a-bccb-0a1d8d754bf1"],
 " and ",
 Cell[BoxData[
  SubsuperscriptBox["R", "C", 
   RowBox[{
    RowBox[{"-", "\[Nu]"}], "-", "1"}]]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "d92501f9-4fba-467c-ae70-c112d5cfb328"],
 " corresponding to Sasakit Tagoshi Eq.(162)."
}], "ExampleText",
 CellChangeTimes->{{3.97712010023674*^9, 3.9771201595392303`*^9}},
 CellID->1930566928,ExpressionUUID->"3c8f45ee-84a3-4e44-beef-5470c13b618d"],

