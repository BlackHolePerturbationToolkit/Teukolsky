             RowBox[{"1", "-", 
              SuperscriptBox["a", "2"]}]]}]}], ")"}]}], "+", 
        RowBox[{"1926", " ", "\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{"a", "+", 
           RowBox[{"3", " ", 
            SuperscriptBox["a", "3"]}]}], ")"}], " ", 
