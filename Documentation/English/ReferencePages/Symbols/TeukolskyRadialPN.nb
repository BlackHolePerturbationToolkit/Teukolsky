          RowBox[{"1", "-", 
           SuperscriptBox["a", "2"]}]], " ", "\[Omega]"}]}], ")"}], " ", 
      SuperscriptBox["\[Eta]", "3"]}]]}], "+", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"24", " ", 
