 CellID->1614255968,ExpressionUUID->"be9d393b-027f-4a34-840b-55a3a281b02e"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Checking against numerics", "ExampleSubsection",ExpressionUUID->
   "bd413e28-2d39-4284-89c7-44fff5812927"],
  $Line = 0; Null]], "ExampleSubsection",
 CellChangeTimes->{{3.947152157584034*^9, 3.947152160196806*^9}, {
  3.9551788591350946`*^9, 3.955178865734518*^9}},
 CellID->481089257,ExpressionUUID->"08e4ff09-dca5-46af-96e8-069ddf67d1ab"],

Cell["\<\
We can check the 6PN energy flux at infinity against the numerics:\
\>", "ExampleText",
 CellChangeTimes->{{3.993747272356493*^9, 3.993747324015505*^9}},
 CellID->43059422,ExpressionUUID->"f372b764-239a-4a66-86f5-13e77c6a6310"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EchoTiming", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"s", "=", 
        RowBox[{"-", "2"}]}], ",", 
       RowBox[{"\[ScriptL]", "=", "2"}], ",", 
       RowBox[{"m", "=", "2"}], ",", "aux", ",", "orbit", ",", "orbitN", ",", 
       
       RowBox[{"order", "=", "13"}], ",", "\[Psi]N", ",", 
       RowBox[{"a", "=", ".7"}], ",", 
       RowBox[{"r0min", "=", "5"}], ",", 
       RowBox[{"r0max", "=", "1000"}], ",", 
       RowBox[{"points", "=", "100"}], ",", 
       RowBox[{"prec", "=", "200"}], ",", "ns", ",", "r0s", ",", "flux", ",", 
       "aa", ",", "orbitPN", ",", "flux2", ",", "fluxPN", ",", "fluxN", ",", 
       "plotAux"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r0s", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"Log", "[", "r0min", "]"}], ",", 
           RowBox[{"Log", "[", "r0max", "]"}], ",", "points"}], "]"}], "//", 
         "Exp"}], "//", 
        RowBox[{
         RowBox[{"SetPrecision", "[", 
          RowBox[{"#", ",", "prec"}], "]"}], "&"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ns", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", "order", ",", "2"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"orbit", "=", 
       RowBox[{"KerrGeoOrbit", "[", 
        RowBox[{
         RowBox[{"SetPrecision", "[", 
          RowBox[{"a", ",", "prec"}], "]"}], ",", "r0", ",", "0", ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"EchoTiming", "[", 
       RowBox[{
        RowBox[{"\[Psi]", "=", 
         RowBox[{"TeukolskyPointParticleModePN", "[", 
          RowBox[{"s", ",", "\[ScriptL]", ",", "m", ",", "orbit", ",", 
           RowBox[{"{", 
            RowBox[{"\[Eta]", ",", "order"}], "}"}]}], "]"}]}], ",", 
        "\"\<\[Psi]PN\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"EchoTiming", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fluxN", "[", "r0", "]"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"TeukolskyPointParticleMode", "[", 
               RowBox[{"s", ",", "\[ScriptL]", ",", "m", ",", "orbit"}], 
               "]"}], "[", "\"\<EnergyFlux\>\"", "]"}], "[", 
             "\"\<\[ScriptCapitalI]\>\"", "]"}], "/.", 
            RowBox[{"aa", "->", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{"a", ",", "prec"}], "]"}]}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"r0", ",", "r0s"}], "}"}]}], "]"}], ",", 
        "\"\<Numerics Table\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"EchoTiming", "[", 
       RowBox[{
        RowBox[{"flux", "=", 
         RowBox[{
          RowBox[{"\[Psi]", "[", "\"\<EnergyFlux\>\"", "]"}], "[", 
          "\"\<\[ScriptCapitalI]\>\"", "]"}]}], ",", "\"\<PN flux\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"EchoTiming", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"flux2", "[", "n", "]"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{"flux", "//", 
              RowBox[{
               RowBox[{"SeriesTake", "[", 
                RowBox[{"#", ",", "n"}], "]"}], "&"}]}], "//", "Normal"}], "//", 
            RowBox[{"ReplaceAll", "[", 
             RowBox[{"\[Eta]", "->", "1"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "ns"}], "}"}]}], "]"}], ",", 
        "\"\<PN Table 1\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"EchoTiming", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"fluxPN", "[", 
              RowBox[{"n", ",", "r0"}], "]"}], "=", 
             RowBox[{"flux2", "[", "n", "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"r0", ",", "r0s"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "ns"}], "}"}]}], "]"}], ",", 
        "\"\<PN Table 2\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"EchoTiming", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"aux", "[", "n", "]"}], "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"r0", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 FractionBox[
                  RowBox[{"fluxPN", "[", 
                   RowBox[{"n", ",", "r0"}], "]"}], 
                  RowBox[{"fluxN", "[", "r0", "]"}]], "-", "1"}], "]"}]}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"r0", ",", "r0s"}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "ns"}], "}"}]}], "]"}], ",", 
        "\"\<Relative Error\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"plotAux", "=", 
       RowBox[{"ListLogLogPlot", "[", 
        RowBox[{
         RowBox[{"aux", "[", "order", "]"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            SuperscriptBox["10", 
             RowBox[{"-", "20"}]], ",", "1"}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "->", "Transparent"}], ",", 
         RowBox[{"ImageSize", "->", "Large"}], ",", 
         RowBox[{"Joined", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\!\(\*SubscriptBox[\(r\), \(0\)]\)\>\"", ",", 
            "\"\<Relative Error\>\""}], "}"}]}], ",", 
