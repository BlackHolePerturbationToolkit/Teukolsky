 CellID->1952683165,ExpressionUUID->"0949db43-a288-4382-9205-e793a9950aa3"],

Cell[TextData[{
 "\"Wronskian\" gives the invariant Wronskian. ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalDelta]", 
    RowBox[{"s", "+", "1"}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SubscriptBox["R", "In"], " ", 
      SubscriptBox[
       RowBox[{"R", "'"}], "Up"]}], "-", 
     RowBox[{
      SubscriptBox["R", "Up"], 
      SubscriptBox[
       RowBox[{"R", "'"}], "In"]}]}], ")"}]}]], "InlineFormula",
  ExpressionUUID->"41811e3f-3301-4f1c-9a3a-7280945ac932"]
}], "ExampleText",
 CellChangeTimes->{{3.942310534791247*^9, 3.942310651191231*^9}, {
  3.942310706564549*^9, 3.942310709710443*^9}},
