Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"-", 
    FractionBox[
     RowBox[{"3", " ", 
      RowBox[{"(", 
       RowBox[{
        SqrtBox[
         FractionBox["\[Pi]", "5"]], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["r0", "5"], " ", 
           RowBox[{"HeavisideTheta", "[", 
            RowBox[{"r", "-", "r0"}], "]"}]}], "+", 
          RowBox[{
           SuperscriptBox["r", "5"], " ", 
           RowBox[{"HeavisideTheta", "[", 
            RowBox[{
             RowBox[{"-", "r"}], "+", "r0"}], "]"}]}]}], ")"}]}], ")"}]}], 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"r", " ", 
        SuperscriptBox["r0", "3"]}], ")"}], " ", 
      SuperscriptBox["\[Eta]", "2"]}]]}], "+", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     SqrtBox[
      FractionBox["\[Pi]", "5"]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        SuperscriptBox["r0", "5"], " ", 
        RowBox[{"HeavisideTheta", "[", 
         RowBox[{"r", "-", "r0"}], "]"}]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["r", "5"], " ", 
        RowBox[{"HeavisideTheta", "[", 
         RowBox[{
          RowBox[{"-", "r"}], "+", "r0"}], "]"}]}]}], ")"}]}], 
    RowBox[{
     SuperscriptBox["r0", 
      RowBox[{"9", "/", "2"}]], " ", "\[Eta]"}]], "+", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "8"]}], " ", 
      SqrtBox[
       RowBox[{"5", " ", "\[Pi]"}]], " ", "r0", " ", 
      RowBox[{"DiracDelta", "[", 
       RowBox[{"r", "-", "r0"}], "]"}]}], "+", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"28", " ", 
        SuperscriptBox["r", "2"], " ", 
        SuperscriptBox["r0", "6"]}]], 
      RowBox[{
       SqrtBox[
        FractionBox["\[Pi]", "5"]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"84", " ", 
             SuperscriptBox["r", "3"], " ", 
             SuperscriptBox["r0", "5"]}], "+", 
            RowBox[{"107", " ", "r", " ", 
             SuperscriptBox["r0", "7"]}], "+", 
            RowBox[{"14", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "3"}], "-", 
               RowBox[{"4", " ", "\[ImaginaryI]", " ", "a"}]}], ")"}], " ", 
             SuperscriptBox["r0", "8"]}]}], ")"}], " ", 
          RowBox[{"HeavisideTheta", "[", 
           RowBox[{"r", "-", "r0"}], "]"}]}], "+", 
         RowBox[{
          SuperscriptBox["r", "5"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"44", " ", 
             SuperscriptBox["r", "3"]}], "-", 
            RowBox[{"63", " ", "r", " ", 
             SuperscriptBox["r0", "2"]}], "+", 
            RowBox[{"84", " ", 
             RowBox[{"(", 
              RowBox[{"2", "+", 
               RowBox[{"\[ImaginaryI]", " ", "a"}]}], ")"}], " ", 
             SuperscriptBox["r0", "3"]}]}], ")"}], " ", 
          RowBox[{"HeavisideTheta", "[", 
           RowBox[{
            RowBox[{"-", "r"}], "+", "r0"}], "]"}]}]}], ")"}]}]}]}], ")"}], 
   "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Eta]", "]"}], "1"],
    SeriesData[$CellContext`\[Eta], 0, {}, -2, 1, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Eta], 0, {
   Rational[-3, 2] (Rational[1, 5] Pi)^
     Rational[1, 
       2] $CellContext`r^(-1) $CellContext`r0^(-3) ($CellContext`r0^5 
      HeavisideTheta[$CellContext`r - $CellContext`r0] + $CellContext`r^5 
      HeavisideTheta[-$CellContext`r + $CellContext`r0]), 
    Complex[0, 1] (Rational[1, 5] Pi)^Rational[1, 2] $CellContext`r0^
     Rational[-9, 2] (
     3 $CellContext`r0^5 HeavisideTheta[$CellContext`r - $CellContext`r0] - 
     2 $CellContext`r^5 HeavisideTheta[-$CellContext`r + $CellContext`r0]), 
    Rational[-1, 8] (5 Pi)^Rational[1, 2] $CellContext`r0 
     DiracDelta[$CellContext`r - $CellContext`r0] + 
    Rational[1, 28] (Rational[1, 5] Pi)^
      Rational[1, 2] $CellContext`r^(-2) $CellContext`r0^(-6) ((
        84 $CellContext`r^3 $CellContext`r0^5 + 
        107 $CellContext`r $CellContext`r0^7 + 
        14 (-3 + Complex[0, -4] $CellContext`a) $CellContext`r0^8) 
       HeavisideTheta[$CellContext`r - $CellContext`r0] + $CellContext`r^5 (
        44 $CellContext`r^3 - 63 $CellContext`r $CellContext`r0^2 + 
        84 (2 + Complex[0, 1] $CellContext`a) $CellContext`r0^3) 
       HeavisideTheta[-$CellContext`r + $CellContext`r0])}, -2, 1, 1],
  Editable->False]], "Output",
 CellChangeTimes->{
  3.942309496705855*^9, {3.942309620360689*^9, 3.9423096240779257`*^9}, 
