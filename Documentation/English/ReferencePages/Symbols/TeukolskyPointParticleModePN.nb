 CellID->55793444,ExpressionUUID->"43e32fa6-c544-452c-bd25-a654dcc2c58c"],

Cell["\<\
The \"Normalization\" option is simply passed down to the homogeneous \
solutions. At this point it is a relic and we advice not to mess with it.\
\>", "ExampleText",
 CellChangeTimes->{{3.94715225736828*^9, 3.947152357669915*^9}, {
  3.947152479394155*^9, 3.947152480027514*^9}, {3.955178782514941*^9, 
  3.9551787982653317`*^9}, {3.993746737955718*^9, 3.993746739553061*^9}},
 CellID->181479368,ExpressionUUID->"3cb24b46-ef44-4681-8409-2ecfe3643620"]
}, Open  ]]
