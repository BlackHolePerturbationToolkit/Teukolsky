Cell["\<\
The \"Simplify\" works exactly like for TeukolskyRadial[]. It performs a \
Simplify before returning the result. It is set to True by default. Setting \
it to False will speed up computation time, but increase the ByteCount.\
\>", "ExampleText",
 CellChangeTimes->{{3.9471516351362967`*^9, 3.9471516881611357`*^9}, {
  3.947152088707502*^9, 3.947152145079746*^9}},
 CellID->16677363,ExpressionUUID->"51631728-79f5-4060-ab12-5f39cc30d140"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"orbit", "=", 
   RowBox[{"KerrGeoOrbit", "[", 
    RowBox[{"a", ",", "r0", ",", "0", ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"EchoTiming", "[", 
  RowBox[{
   RowBox[{"TeukolskyPointParticleModePN", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "orbit", ",", 
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", "10"}], "}"}]}], "]"}], "//", "ByteCount"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"EchoTiming", "[", 
  RowBox[{
   RowBox[{"TeukolskyPointParticleModePN", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "orbit", ",", 
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", "10"}], "}"}], ",", 
     RowBox[{"\"\<Simplify\>\"", "->", "False"}]}], "]"}], "//", 
   "ByteCount"}], "]"}]}], "Input",
 CellChangeTimes->{{3.942221956582928*^9, 3.94222199381381*^9}, {
   3.942222147391078*^9, 3.942222148633972*^9}, 3.946104722586904*^9, 
   3.946104814370336*^9, 3.9471462963734617`*^9, {3.9471517111457*^9, 
