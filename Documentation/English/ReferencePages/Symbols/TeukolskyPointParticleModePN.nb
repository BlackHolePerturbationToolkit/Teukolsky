Cell[CellGroupData[{

Cell["ExtendedHomogeneous", "ExampleSubsection",
 CellChangeTimes->{{3.955177787317778*^9, 3.955177789383356*^9}, {
  3.95517782725209*^9, 3.9551778394016933`*^9}},
 CellID->404582589,ExpressionUUID->"c93011ae-f36d-4be3-a26d-43b6274ca2dc"],

Cell[TextData[{
 "\"ExtendedHomogeneous\" \[Rule] \"\[ScriptCapitalI]\" gives the extended \
homogenous solution on the infinity side of the particle, i.e., ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["Z", "\[ScriptL]\[ScriptM]\[Omega]", "Up"], 
   SubsuperscriptBox["R", "\[ScriptL]\[ScriptM]\[Omega]", "Up"]}]], 
  "InlineFormula",ExpressionUUID->"bd82a563-c1b2-46df-b6cf-67a7533a06ec"],
 " where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["Z", "\[ScriptL]\[ScriptM]\[Omega]", "Up"], 
    RowBox[{"HeavisideTheta", "[", 
     RowBox[{"r", "-", "r0"}], "]"}]}], "=", 
   SubsuperscriptBox["c", "\[ScriptL]\[ScriptM]\[Omega]", "Up"]}]], 
  "InlineFormula",ExpressionUUID->"06fddb09-77ce-41ce-a0a0-0ab5fbaf010c"],
