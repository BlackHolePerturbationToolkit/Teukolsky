Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   InterpretationBox[
    RowBox[{
     FractionBox[
      RowBox[{"3", " ", 
       SqrtBox[
        RowBox[{"5", " ", "\[Pi]"}]], " ", 
       SuperscriptBox["r0", "2"], " ", 
       RowBox[{"DiracDelta", "[", 
        RowBox[{"r", "-", "r0"}], "]"}]}], 
      RowBox[{"2", " ", 
       SuperscriptBox["\[Eta]", "4"]}]], "+", 
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", 
        SqrtBox[
         RowBox[{"5", " ", "\[Pi]"}]], " ", 
        SuperscriptBox["r0", 
         RowBox[{"3", "/", "2"}]], " ", 
        RowBox[{"DiracDelta", "[", 
         RowBox[{"r", "-", "r0"}], "]"}]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        SqrtBox[
         RowBox[{"5", " ", "\[Pi]"}]], " ", 
        SuperscriptBox["r0", 
         RowBox[{"5", "/", "2"}]], " ", 
        RowBox[{
         SuperscriptBox["DiracDelta", "\[Prime]",
          MultilineFunction->None], "[", 
         RowBox[{"r", "-", "r0"}], "]"}]}]}], 
      SuperscriptBox["\[Eta]", "3"]], "+", 
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["\[Eta]", "2"]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["1", "4"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "25"}], "+", 
           RowBox[{"12", " ", "\[ImaginaryI]", " ", "a"}]}], ")"}], " ", 
         SqrtBox[
          RowBox[{"5", " ", "\[Pi]"}]], " ", "r0", " ", 
         RowBox[{"DiracDelta", "[", 
          RowBox[{"r", "-", "r0"}], "]"}]}], "+", 
        RowBox[{
         FractionBox["1", "4"], " ", 
         RowBox[{"(", 
          RowBox[{"3", "-", 
           RowBox[{"4", " ", "\[ImaginaryI]", " ", "a"}]}], ")"}], " ", 
         SqrtBox[
          RowBox[{"5", " ", "\[Pi]"}]], " ", 
         SuperscriptBox["r0", "2"], " ", 
         RowBox[{
          SuperscriptBox["DiracDelta", "\[Prime]",
           MultilineFunction->None], "[", 
          RowBox[{"r", "-", "r0"}], "]"}]}], "-", 
        RowBox[{
         FractionBox["1", "8"], " ", 
         SqrtBox[
          RowBox[{"5", " ", "\[Pi]"}]], " ", 
         SuperscriptBox["r0", "3"], " ", 
         RowBox[{
          SuperscriptBox["DiracDelta", "\[Prime]\[Prime]",
           MultilineFunction->None], "[", 
          RowBox[{"r", "-", "r0"}], "]"}]}]}], ")"}]}], "+", 
     InterpretationBox[
      FractionBox["1", 
       RowBox[{"O", "[", "\[Eta]", "]"}]],
      SeriesData[$CellContext`\[Eta], 0, {}, -4, -1, 1],
      Editable->False]}],
    SeriesData[$CellContext`\[Eta], 0, {
     Rational[3, 2] (5 Pi)^Rational[1, 2] $CellContext`r0^2 
      DiracDelta[$CellContext`r - $CellContext`r0], 
      Complex[0, -2] (5 Pi)^Rational[1, 2] $CellContext`r0^Rational[3, 2] 
       DiracDelta[$CellContext`r - $CellContext`r0] + 
      Complex[0, 1] (5 Pi)^Rational[1, 2] $CellContext`r0^Rational[5, 2] 
       Derivative[1][DiracDelta][$CellContext`r - $CellContext`r0], 
      Rational[1, 4] (-25 + Complex[0, 12] $CellContext`a) (5 Pi)^
        Rational[1, 2] $CellContext`r0 
       DiracDelta[$CellContext`r - $CellContext`r0] + 
      Rational[1, 4] (3 + Complex[0, -4] $CellContext`a) (5 Pi)^
        Rational[1, 2] $CellContext`r0^2 
       Derivative[1][DiracDelta][$CellContext`r - $CellContext`r0] + 
      Rational[-1, 8] (5 Pi)^Rational[1, 2] $CellContext`r0^3 
       Derivative[2][DiracDelta][$CellContext`r - $CellContext`r0]}, -4, -1, 
     1],
    Editable->False], ")"}], "[", "r", "]"}]], "Output",
 CellChangeTimes->{{3.942310783957175*^9, 3.942310809904798*^9}, 
