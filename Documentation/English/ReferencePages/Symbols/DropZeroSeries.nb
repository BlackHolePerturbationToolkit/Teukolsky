Cell["\<\
DropZeroSeries allows to set the zero series to zero without using Normal\
\>", "ExampleText",
 CellChangeTimes->{{3.998035420647058*^9, 3.998035473201343*^9}},
 CellID->1622514160,ExpressionUUID->"ba61bef6-9369-4b31-8ef1-2cba5ab0538b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  FractionBox[
   RowBox[{
    SuperscriptBox["x", "10"], "+", 
    SuperscriptBox["x", "\[ScriptL]"]}], 
   RowBox[{"1", "+", "x"}]], "//", 
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{"#", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "4"}], "}"}]}], "]"}], 
   "&"}]}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "DropZeroSeries"}]}], "Input",
 CellChangeTimes->{{3.998035388774948*^9, 3.9980354339320087`*^9}},
 CellLabel->"In[13]:=",
 CellID->628345128,ExpressionUUID->"579e7495-0b2d-49b2-b1c6-90660d7ec78e"],

Cell[BoxData[
 RowBox[{
  InterpretationBox[
   SuperscriptBox[
    RowBox[{"O", "[", "x", "]"}], "10"],
   SeriesData[$CellContext`x, 0, {}, 10, 10, 1],
   Editable->False], "+", 
  RowBox[{
   SuperscriptBox["x", "\[ScriptL]"], " ", 
   RowBox[{"(", 
    InterpretationBox[
     RowBox[{"1", "-", "x", "+", 
      SuperscriptBox["x", "2"], "-", 
      SuperscriptBox["x", "3"], "+", 
      SuperscriptBox["x", "4"], "+", 
      InterpretationBox[
       SuperscriptBox[
        RowBox[{"O", "[", "x", "]"}], "5"],
       SeriesData[$CellContext`x, 0, {}, 0, 5, 1],
       Editable->False]}],
     SeriesData[$CellContext`x, 0, {1, -1, 1, -1, 1}, 0, 5, 1],
     Editable->False], ")"}]}]}]], "Output",
 CellChangeTimes->{{3.998035408496393*^9, 3.998035434215467*^9}},
 CellLabel->"Out[13]=",
 CellID->1297250093,ExpressionUUID->"66db1b15-457d-4955-a4bb-25669b086e7f"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["x", "\[ScriptL]"], " ", 
  RowBox[{"(", 
   InterpretationBox[
    RowBox[{"1", "-", "x", "+", 
     SuperscriptBox["x", "2"], "-", 
     SuperscriptBox["x", "3"], "+", 
     SuperscriptBox["x", "4"], "+", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "x", "]"}], "5"],
      SeriesData[$CellContext`x, 0, {}, 0, 5, 1],
      Editable->False]}],
    SeriesData[$CellContext`x, 0, {1, -1, 1, -1, 1}, 0, 5, 1],
    Editable->False], ")"}]}]], "Output",
 CellChangeTimes->{{3.998035408496393*^9, 3.998035434217052*^9}},
 CellLabel->"Out[14]=",
 CellID->659150200,ExpressionUUID->"0e4be536-09ff-4bc2-9157-922d48d1230b"]
}, Open  ]]
}, Open  ]],

