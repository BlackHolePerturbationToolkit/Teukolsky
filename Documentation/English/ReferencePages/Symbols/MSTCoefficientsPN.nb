Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Normal", "[", "#", "]"}], "&"}], "/@", 
   RowBox[{"(", 
    RowBox[{
