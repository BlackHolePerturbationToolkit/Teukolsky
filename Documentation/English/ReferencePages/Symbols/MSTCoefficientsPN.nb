Notebook[{

Cell[CellGroupData[{
Cell["MSTCoefficientsPN", "ObjectName",
 CellID->1805789284,ExpressionUUID->"9900a36f-48fd-4264-b97e-b2224a7edbd0"],

Cell["\<\
\tMSTCoefficientsPN[\[ScriptS], \[ScriptL], \[ScriptM], a, \[Omega], \
{\[Gamma], n}] gives the MST coefficients aMST[n] and renormalized angular \
momentum \[Nu]MST for a given {\[ScriptS], \[ScriptL], \[ScriptM]} mode as a \
series in \[Omega] . a is the Kerr spin parameter, \[Gamma] is a power \
counting parameter, and n is the number of terms \"\
\>", "Usage",
 CellChangeTimes->{{3.974714466717105*^9, 3.974714487042964*^9}, {
  3.974714693803117*^9, 3.974714725999035*^9}},
 CellID->1517043135,ExpressionUUID->"fc40aff1-4890-4d4f-8f51-ed034771ab11"],

Cell["The following options can be given: ", "Notes",
 CellID->1821323233,ExpressionUUID->"caa08a04-fb26-4492-aed2-c51fb9132466"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a2492920-c622-4dbe-9ccf-3ac2f9ae58d7"], "\"\<FreqRep\>\"", 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "Changes how to scale \[Omega]. If set to one it expands linarly in by ",
     
     Cell[BoxData[
      RowBox[{"\[Omega]", "->", 
       RowBox[{"\[Gamma]", " ", "\[Omega]"}]}]], "InlineFormula",
      ExpressionUUID->"17cdfea4-2627-4798-91a7-fe89173ee558"],
     ". If set to False it will expand ",
     Cell[BoxData[
      RowBox[{"\[Omega]", "->", 
       RowBox[{
        SuperscriptBox["\[Eta]", "3"], " ", "\[Omega]"}]}]], "InlineFormula",
      ExpressionUUID->"6f2606c9-e354-404f-a1ac-5bf6363e9f5f"],
     ". The second case is less readable, but compatible with the PN scalings \
used in TeukolskyRadialPN, where the presence of r matters."
    }], "TableText",ExpressionUUID->"ea80833e-625f-40f6-a056-db84ef162266"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{3.977125845927067*^9, 3.977125845927081*^9}, {
  3.97712589544422*^9, 3.977125895444248*^9}},
 CellID->117507471,ExpressionUUID->"f920a58c-b170-48c4-8e4d-17da63ca533d"]
}, Open  ]],

