Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "-", 
       RowBox[{"5", " ", 
        SuperscriptBox["a", "2"]}], "-", 
       RowBox[{"5", " ", "\[ImaginaryI]", " ", "a", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}]]}]}], ")"}], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "3"}], "+", "\[ScriptL]"}], ")"}], "2"], " ", 
     SuperscriptBox["\[Omega]", "2"], " ", 
     SuperscriptBox["\[Gamma]", "2"]}], "1575"], "+", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"12", " ", "a"}], "+", 
       RowBox[{"40", " ", 
        SuperscriptBox["a", "3"]}], "+", 
       RowBox[{"45", " ", "\[ImaginaryI]", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}]]}], "+", 
       RowBox[{"40", " ", "\[ImaginaryI]", " ", 
        SuperscriptBox["a", "2"], " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}]]}]}], ")"}], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "3"}], "+", "\[ScriptL]"}], ")"}], "2"], " ", 
     SuperscriptBox["\[Omega]", "3"], " ", 
     SuperscriptBox["\[Gamma]", "3"]}], "14175"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Gamma]", "]"}], "5"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 2, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 0, {
   Rational[1, 1575] (3 - 5 $CellContext`a^2 + 
     Complex[0, -5] $CellContext`a (1 - $CellContext`a^2)^
       Rational[
        1, 2]) (-3 + $CellContext`\[ScriptL])^2 $CellContext`\[Omega]^2, 
    Rational[1, 14175] (12 $CellContext`a + 40 $CellContext`a^3 + 
     Complex[0, 45] (1 - $CellContext`a^2)^Rational[1, 2] + 
     Complex[0, 40] $CellContext`a^2 (1 - $CellContext`a^2)^
       Rational[
        1, 2]) (-3 + $CellContext`\[ScriptL])^2 $CellContext`\[Omega]^3}, 2, 
   5, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.97712563267552*^9, 3.977125698769616*^9}, {
   3.977126741840233*^9, 3.977126766755258*^9}, {3.977126799452941*^9, 
   3.977126902674865*^9}, 3.993743354001307*^9},
 CellLabel->"Out[125]=",
 CellID->1486872497,ExpressionUUID->"36ce7761-0e7b-4bab-95ca-639dd7814574"],

