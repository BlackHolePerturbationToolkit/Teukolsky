Cell["\<\
Plugging in specific values can be fiddly as a simple replacement might \
introduce intermediate but canceling divergencies. Mapping a second Series \
onto the series coefficients handles these automatically. \
\>", "ExampleText",
 CellChangeTimes->{{3.977125502119017*^9, 3.977125575330132*^9}},
 CellID->436049597,ExpressionUUID->"196f8d1f-c6eb-4776-a494-a506eb501feb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Normal", "[", "#", "]"}], "&"}], "/@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Series", "[", 
       RowBox[{"#", ",", 
        RowBox[{"\[ScriptL]", "->", "5"}]}], "]"}], "&"}], "/@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"testGeneric\[ScriptL]", "[", "\[Nu]MST", "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[ScriptM]", "->", "2"}], "}"}]}], ")"}]}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"testSpecific\[ScriptL]", "[", "\[Nu]MST", "]"}], "-", 
  "%"}]}], "Input",
 CellChangeTimes->{{3.9771253368080263`*^9, 3.977125497056355*^9}, {
  3.977126712280813*^9, 3.977126719204629*^9}},
 CellLabel->"In[76]:=",
 CellID->1590508261,ExpressionUUID->"6e436c4c-1347-4db3-a9ad-be9f3f5e401d"],

Cell[BoxData[
 InterpretationBox[
  SuperscriptBox[
   RowBox[{"O", "[", "\[Gamma]", "]"}], "5"],
  SeriesData[$CellContext`\[Gamma], 0, {}, 5, 5, 1],
  Editable->False]], "Output",
 CellChangeTimes->{
  3.977125347281659*^9, {3.977125384640781*^9, 3.977125393010419*^9}, 
   3.977125451265668*^9, {3.9771254840452137`*^9, 3.977125498489443*^9}, {
   3.977126705558807*^9, 3.977126719538507*^9}},
 CellLabel->"Out[77]=",
 CellID->544323934,ExpressionUUID->"77267418-b6f1-405a-9de0-c071837a731b"]
}, Open  ]],

