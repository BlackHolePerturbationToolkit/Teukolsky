Cell[TextData[{
 "The amplitudes do not depend on the radial coordinate. This means that \
(going by the PN scalings ",
 Cell[BoxData[
  RowBox[{"\[Omega]", "~", 
   SuperscriptBox["\[Eta]", "3"]}]], "InlineFormula",ExpressionUUID->
  "77c47e1e-11b7-4bee-abb9-03ba4ea593dd"],
 " and ",
 Cell[BoxData[
  RowBox[{"r", "~", 
   SuperscriptBox["\[Eta]", 
    RowBox[{"-", "2"}]]}]], "InlineFormula",ExpressionUUID->
  "c526e530-a2af-4ccd-b9b8-1d0b7174cfe2"],
 ") they would always come in powers of ",
 Cell[BoxData[
  SuperscriptBox["\[Eta]", "3"]], "InlineFormula",ExpressionUUID->
  "5189cce1-cf15-4bed-92ae-785ddf2c4528"],
 ". By default we thus count directly in powers of ",
 Cell[BoxData[
 "\[Omega]"], "InlineFormula",ExpressionUUID->
  "77a99c50-9475-4756-bf25-a4d625113185"],
 " instead of ",
 Cell[BoxData[
  SuperscriptBox["\[Omega]", 
   FractionBox["1", "3"]]], "InlineFormula",ExpressionUUID->
  "cd5ff5ef-0c9d-47c3-86d4-ba01cfe6e778"],
 ". The \"FreqRep\"  Option allows to disable this behavior  "
}], "ExampleText",
 CellChangeTimes->{{3.974699605935677*^9, 3.974699628977455*^9}, {
  3.974699662689919*^9, 3.974699796699436*^9}, {3.97469987823496*^9, 
  3.974699898636429*^9}},
 CellID->629816592,ExpressionUUID->"91f803b1-4265-4577-8c00-3296e4a95195"],

