           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}]]}]}], ")"}], " ", "\[Omega]", " ", 
       "\[Gamma]"}], "+", 
      RowBox[{
       FractionBox["10", "81"], " ", 
       RowBox[{"(", 
        RowBox[{"9", "+", 
         RowBox[{"2", " ", 
