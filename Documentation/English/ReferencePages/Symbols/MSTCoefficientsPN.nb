      RowBox[{"O", "[", "\[Gamma]", "]"}], "3"],
     SeriesData[$CellContext`\[Gamma], 0, {}, 3, 3, 1],
     Editable->False]}], ",", 
   RowBox[{
    RowBox[{"aMST", "[", 
