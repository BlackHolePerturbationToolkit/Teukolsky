Cell["\<\
Paint allows to highlight compound expressions. This is especially helpful \
when wanting to find forms in large expressions. \
\>", "ExampleText",
 CellChangeTimes->{{3.997969493515121*^9, 3.997969537618615*^9}},
 CellID->390530464,ExpressionUUID->"5a69b722-3870-4b66-9053-b0f994528353"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], "+", "g", "+", 
   RowBox[{"Sin", "[", "y", "]"}], "+", 
   SuperscriptBox["x", "4"], "+", 
   SuperscriptBox["\[ExponentialE]", "x"]}], "//", 
  RowBox[{
   RowBox[{"Paint", "[", 
    RowBox[{"#", ",", "x"}], "]"}], "&"}]}]], "Input",
