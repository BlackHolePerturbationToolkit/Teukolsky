Cell["\<\
ChooseSide allows to choose a side of piecewise functions that are defined \
with Heavisides. \
\>", "ExampleText",
 CellChangeTimes->{{3.9979419866391363`*^9, 3.9979420338269043`*^9}},
 CellID->191070011,ExpressionUUID->"a71ff3c9-75bf-48d3-bbde-df7d027881f7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"expr", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"left", "[", "x", "]"}], " ", 
    RowBox[{"HeavisideTheta", "[", 
     RowBox[{"x", "-", "x0"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"right", "[", "x", "]"}], 
    RowBox[{"HeavisideTheta", "[", 
     RowBox[{"x0", "-", "x"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"delta", "[", "x", "]"}], 
    RowBox[{"DiracDelta", "[", 
     RowBox[{"x", "-", "x0"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"expr", "//", 
  RowBox[{
   RowBox[{"ChooseSide", "[", 
    RowBox[{"#", ",", 
     RowBox[{"x", ">", "x0"}]}], "]"}], "&"}]}], "\[IndentingNewLine]", 
 RowBox[{"expr", "//", 
  RowBox[{
   RowBox[{"ChooseSide", "[", 
    RowBox[{"#", ",", 
     RowBox[{"x", "<", "x0"}]}], "]"}], "&"}]}]}], "Input",
 CellChangeTimes->{{3.997941914299662*^9, 3.997941970738375*^9}},
 CellLabel->"In[5]:=",
 CellID->1389382740,ExpressionUUID->"95fb3f7e-bf8d-4ae4-8213-ce5ed001af7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"delta", "[", "x", "]"}], " ", 
   RowBox[{"DiracDelta", "[", 
    RowBox[{"x", "-", "x0"}], "]"}]}], "+", 
  RowBox[{
   RowBox[{"HeavisideTheta", "[", 
    RowBox[{"x", "-", "x0"}], "]"}], " ", 
   RowBox[{"left", "[", "x", "]"}]}], "+", 
  RowBox[{
   RowBox[{"HeavisideTheta", "[", 
    RowBox[{
     RowBox[{"-", "x"}], "+", "x0"}], "]"}], " ", 
   RowBox[{"right", "[", "x", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.997941962525157*^9, 3.997941971092651*^9}, 
   3.998455749863904*^9},
 CellLabel->"Out[5]=",
 CellID->737727891,ExpressionUUID->"c26de2e7-6071-4195-bf56-69303ba3d6e3"],

Cell[BoxData[
 RowBox[{"left", "[", "x", "]"}]], "Output",
 CellChangeTimes->{{3.997941962525157*^9, 3.997941971092651*^9}, 
   3.998455749931205*^9},
 CellLabel->"Out[6]=",
 CellID->487796105,ExpressionUUID->"fbc2a05e-370e-4e16-8ae8-7ab5cc76b468"],

Cell[BoxData[
 RowBox[{"right", "[", "x", "]"}]], "Output",
 CellChangeTimes->{{3.997941962525157*^9, 3.997941971092651*^9}, 
   3.998455749951893*^9},
 CellLabel->"Out[7]=",
 CellID->829463153,ExpressionUUID->"9ab92016-52c0-410c-874c-e16e25528d4d"]
}, Open  ]],

Cell[TextData[{
 "The difference to using Simplify is that the rest of the expressions are \
not simplified, which can potentially slow down the computation. In this \
example we tell ",
 Cell[BoxData[
  ButtonBox["Simplify",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "fab2b882-e315-4d90-874e-379a998d3e91"],
 " to transform ",
 Cell[BoxData[
  RowBox[{
   StyleBox["right", "TI"], "[", 
   StyleBox["x", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "44707129-4577-415b-adb3-e9c2c506f169"],
 " via a transformation function:"
}], "ExampleText",
 CellChangeTimes->{{3.997942059342813*^9, 3.997942082586589*^9}, {
  3.997954534148306*^9, 3.997954589078713*^9}, {3.998455624524845*^9, 
  3.998455731807529*^9}},
 CellID->1857501189,ExpressionUUID->"2b16b431-7fec-48ad-ad14-7d2704024e40"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rightTF", "[", "expr_", "]"}], ":=", 
  RowBox[{"expr", "/.", " ", 
   RowBox[{
    RowBox[{"right", "[", "x_", "]"}], ":>", 
    RowBox[{"simplifiedRight", "[", "x", "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"Simplify", ",", 
    RowBox[{"TransformationFunctions", "->", 
     RowBox[{"{", 
      RowBox[{"Automatic", ",", "rightTF"}], "}"}]}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.997942300355779*^9, 3.997942308209154*^9}, {
  3.997942386706604*^9, 3.997942386865773*^9}},
 CellLabel->"In[8]:=",
 CellID->1551690580,ExpressionUUID->"a7370143-9305-4141-bf96-c10987cfc2fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"expr", "//", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{"x", "<", "x0"}]}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.997942042433865*^9, 3.9979420530623198`*^9}, {
  3.99794210708267*^9, 3.99794213083288*^9}, {3.997954612892814*^9, 
  3.9979546224283*^9}, {3.9984557452098007`*^9, 3.99845574565394*^9}},
 CellLabel->"In[10]:=",
 CellID->1296857203,ExpressionUUID->"bb49114d-d6b5-42fb-aa65-2b1f8e0d160b"],

Cell[BoxData[
 RowBox[{"simplifiedRight", "[", "x", "]"}]], "Output",
 CellChangeTimes->{
  3.997942053452141*^9, 3.997942131511139*^9, {3.997954614445113*^9, 
   3.997954623201621*^9}, {3.998455746850939*^9, 3.998455752524539*^9}},
 CellLabel->"Out[10]=",
 CellID->419917810,ExpressionUUID->"96f4e872-8225-4fec-9c5d-2baad7aabc0f"]
}, Open  ]],

