Cell["\<\
ChooseSide allows to choose a side of piecewise functions that are defined \
with Heavisides. \
\>", "ExampleText",
 CellChangeTimes->{{3.9979419866391363`*^9, 3.9979420338269043`*^9}},
 CellID->191070011,ExpressionUUID->"a71ff3c9-75bf-48d3-bbde-df7d027881f7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"expr", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"left", "[", "x", "]"}], " ", 
    RowBox[{"HeavisideTheta", "[", 
     RowBox[{"x", "-", "x0"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"right", "[", "x", "]"}], 
    RowBox[{"HeavisideTheta", "[", 
     RowBox[{"x0", "-", "x"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"delta", "[", "x", "]"}], 
    RowBox[{"DiracDelta", "[", 
     RowBox[{"x", "-", "x0"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"expr", "//", 
  RowBox[{
   RowBox[{"ChooseSide", "[", 
    RowBox[{"#", ",", 
     RowBox[{"x", ">", "x0"}]}], "]"}], "&"}]}], "\[IndentingNewLine]", 
 RowBox[{"expr", "//", 
  RowBox[{
   RowBox[{"ChooseSide", "[", 
    RowBox[{"#", ",", 
     RowBox[{"x", "<", "x0"}]}], "]"}], "&"}]}]}], "Input",
 CellChangeTimes->{{3.997941914299662*^9, 3.9979419707383747`*^9}},
 CellLabel->"In[18]:=",
 CellID->1389382740,ExpressionUUID->"95fb3f7e-bf8d-4ae4-8213-ce5ed001af7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"delta", "[", "x", "]"}], " ", 
   RowBox[{"DiracDelta", "[", 
    RowBox[{"x", "-", "x0"}], "]"}]}], "+", 
  RowBox[{
   RowBox[{"HeavisideTheta", "[", 
    RowBox[{"x", "-", "x0"}], "]"}], " ", 
   RowBox[{"left", "[", "x", "]"}]}], "+", 
  RowBox[{
   RowBox[{"HeavisideTheta", "[", 
    RowBox[{
     RowBox[{"-", "x"}], "+", "x0"}], "]"}], " ", 
   RowBox[{"right", "[", "x", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.997941962525157*^9, 3.997941971092651*^9}},
 CellLabel->"Out[18]=",
 CellID->581720785,ExpressionUUID->"dec3c4da-6182-49d5-b9e8-27271b450573"],

Cell[BoxData[
 RowBox[{"left", "[", "x", "]"}]], "Output",
 CellChangeTimes->{{3.997941962525157*^9, 3.9979419710938396`*^9}},
 CellLabel->"Out[19]=",
 CellID->156690227,ExpressionUUID->"b9218d31-996c-4b84-9c10-1814f023e509"],

Cell[BoxData[
 RowBox[{"right", "[", "x", "]"}]], "Output",
 CellChangeTimes->{{3.997941962525157*^9, 3.997941971094565*^9}},
 CellLabel->"Out[20]=",
 CellID->983889069,ExpressionUUID->"ec838324-9b1a-4648-a5ec-8d0d2c9a62f4"]
}, Open  ]],

Cell["\<\
The difference to using Simplify is that the rest of the expressions are not \
simplified, which can potentially take long\
\>", "ExampleText",
 CellChangeTimes->{{3.997942059342813*^9, 3.997942082586589*^9}, {
  3.997954534148306*^9, 3.997954589078713*^9}},
 CellID->1857501189,ExpressionUUID->"2b16b431-7fec-48ad-ad14-7d2704024e40"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rightTF", "[", "expr_", "]"}], ":=", 
  RowBox[{"expr", "/.", " ", 
   RowBox[{
    RowBox[{"right", "[", "x_", "]"}], ":>", 
    RowBox[{"simplifiedRight", "[", "x", "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"Simplify", ",", 
    RowBox[{"TransformationFunctions", "->", 
     RowBox[{"{", 
      RowBox[{"Automatic", ",", "rightTF"}], "}"}]}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9979423003557796`*^9, 3.997942308209154*^9}, {
  3.997942386706604*^9, 3.997942386865773*^9}},
 CellLabel->"In[35]:=",
 CellID->1551690580,ExpressionUUID->"a7370143-9305-4141-bf96-c10987cfc2fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"expr", "//", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{"x", "<", "x0"}]}], "]"}], "&"}]}], "\[IndentingNewLine]", 
 RowBox[{"expr", "//", 
  RowBox[{
   RowBox[{"ChooseSide", "[", 
    RowBox[{"#", ",", 
     RowBox[{"x", "<", "x0"}]}], "]"}], "&"}]}]}], "Input",
 CellChangeTimes->{{3.997942042433865*^9, 3.9979420530623198`*^9}, {
  3.99794210708267*^9, 3.99794213083288*^9}, {3.9979546128928137`*^9, 
  3.9979546224283*^9}},
 CellLabel->"In[38]:=",
 CellID->1296857203,ExpressionUUID->"bb49114d-d6b5-42fb-aa65-2b1f8e0d160b"],

Cell[BoxData[
 RowBox[{"simplifiedRight", "[", "x", "]"}]], "Output",
 CellChangeTimes->{
  3.997942053452141*^9, 3.997942131511139*^9, {3.997954614445113*^9, 
   3.997954623201621*^9}},
 CellLabel->"Out[38]=",
 CellID->786836789,ExpressionUUID->"5053eb7e-4a4c-48bc-987f-e9a25caaee89"],

Cell[BoxData[
 RowBox[{"right", "[", "x", "]"}]], "Output",
 CellChangeTimes->{
  3.997942053452141*^9, 3.997942131511139*^9, {3.997954614445113*^9, 
   3.997954623202469*^9}},
 CellLabel->"Out[39]=",
 CellID->705253446,ExpressionUUID->"3fb4cd97-a1cc-43c1-b825-8b257552298f"]
}, Open  ]]
}, Open  ]],

