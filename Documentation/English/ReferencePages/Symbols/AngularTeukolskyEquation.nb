Cell["\<\
AngularTeukolskyEquation returns the angular Teukolsky/ spheroidal equation\
\>", "ExampleText",
 CellChangeTimes->{{3.9980330462909737`*^9, 3.998033064897297*^9}},
 CellID->550891920,ExpressionUUID->"a2b3c41b-9177-4c73-860b-8c86da976c61"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AngularTeukolskyEquation", "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "\[Gamma]", ",", "\[Theta]", 
   ",", "\[Phi]"}], "]"}]], "Input",
 CellChangeTimes->{{3.998033016177988*^9, 3.998033023570558*^9}},
 CellLabel->"In[385]:=",
 CellID->1584132725,ExpressionUUID->"632d4e1e-a7c3-491d-9261-e0af5db6b39b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "2"}], "+", 
     RowBox[{"2", " ", "\[Gamma]", " ", 
      RowBox[{"(", 
       RowBox[{"2", "+", 
        RowBox[{"2", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"2", "-", 
         RowBox[{"2", " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"]}], "-", 
     RowBox[{
      SuperscriptBox["\[Gamma]", "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "+", 
     InterpretationBox[
      FrameBox[
       RowBox[{
        SubscriptBox["", 
         RowBox[{"-", "2"}]], 
        SubscriptBox["\[Lambda]", 
         RowBox[{"2", " ", "2"}]], 
        RowBox[{"[", "\[Gamma]", "]"}]}],
       Background->None,
       FrameMargins->{{0, 1}, {0, 0}},
       FrameStyle->None],
      SpinWeightedSpheroidalHarmonics`SpinWeightedSpheroidalEigenvalue[-2, 2, 
       2, $CellContext`\[Gamma]]]}], ")"}], " ", 
   InterpretationBox[
    FrameBox[
     RowBox[{
      SubscriptBox["", 
       RowBox[{"-", "2"}]], 
      SubscriptBox["S", 
       RowBox[{"2", " ", "2"}]], 
      RowBox[{"[", "\[Gamma]", ",", "\[Theta]", ",", "\[Phi]", "]"}]}],
     Background->None,
     FrameMargins->{{0, 1}, {0, 0}},
     FrameStyle->None],
    SpinWeightedSpheroidalHarmonics`SpinWeightedSpheroidalHarmonicS[-2, 2, 
     2, $CellContext`\[Gamma], $CellContext`\[Theta], $CellContext`\[Phi]]]}],
   "+", 
  RowBox[{
   RowBox[{"Cot", "[", "\[Theta]", "]"}], " ", 
   InterpretationBox[
    FrameBox[
     RowBox[{
      SubscriptBox["", 
       RowBox[{"-", "2"}]], 
      SubsuperscriptBox["S", 
       RowBox[{"2", " ", "2"}], 
       RowBox[{"(", "0", ",", "1", ",", "0", ")"}]], 
      RowBox[{"[", "\[Gamma]", ",", "\[Theta]", ",", "\[Phi]", "]"}]}],
     Background->None,
     FrameMargins->{{0, 1}, {0, 0}},
     FrameStyle->None],
    Derivative[0, 0, 0, 0, 1, 0][
    SpinWeightedSpheroidalHarmonics`SpinWeightedSpheroidalHarmonicS][-2, 2, 
     2, $CellContext`\[Gamma], $CellContext`\[Theta], $CellContext`\[Phi]]]}],
   "+", 
  InterpretationBox[
   FrameBox[
    RowBox[{
     SubscriptBox["", 
      RowBox[{"-", "2"}]], 
     SubsuperscriptBox["S", 
      RowBox[{"2", " ", "2"}], 
      RowBox[{"(", "0", ",", "2", ",", "0", ")"}]], 
     RowBox[{"[", "\[Gamma]", ",", "\[Theta]", ",", "\[Phi]", "]"}]}],
    Background->None,
    FrameMargins->{{0, 1}, {0, 0}},
    FrameStyle->None],
   Derivative[0, 0, 0, 0, 2, 0][
   SpinWeightedSpheroidalHarmonics`SpinWeightedSpheroidalHarmonicS][-2, 2, 
    2, $CellContext`\[Gamma], $CellContext`\[Theta], \
$CellContext`\[Phi]]]}]], "Output",
 CellChangeTimes->{3.9980330239147797`*^9, 3.9980330673103743`*^9},
 CellLabel->"Out[385]=",
 CellID->813221175,ExpressionUUID->"9737175e-c687-4da5-a312-784b396e082c"]
}, Open  ]],

