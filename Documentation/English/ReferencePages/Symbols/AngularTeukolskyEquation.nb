     RowBox[{"SetPrecision", "[", 
      RowBox[{"\[Gamma]", ",", "prec"}], "]"}], ",", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{"\[Theta]", ",", "prec"}], "]"}], ",", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{"\[Phi]", ",", "prec"}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
