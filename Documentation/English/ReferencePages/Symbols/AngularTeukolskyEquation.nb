 CellID->1475709376,ExpressionUUID->"9a65b5dd-68ac-4656-aa9c-c3e6b9dea2ca"],

Cell[BoxData[
 RowBox[{"0``198.13583502659546", "+", 
  RowBox[{"0``197.95026647908844", " ", "\[ImaginaryI]"}]}]], "Output",
 CellChangeTimes->{
  3.998033076970461*^9, {3.9980331362609167`*^9, 3.998033152967575*^9}},
