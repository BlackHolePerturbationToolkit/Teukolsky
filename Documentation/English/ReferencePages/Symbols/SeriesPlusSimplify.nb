Cell["\<\
In the following example one of the two series is always suppressed for \
\[ScriptL]>0. This is not recognized by FullSimplify\
\>", "ExampleText",
 CellChangeTimes->{{3.998028426930637*^9, 3.998028448795652*^9}, {
  3.99802848236723*^9, 3.998028587849568*^9}},
 CellID->1063147488,ExpressionUUID->"8d963a62-5a64-49e0-b437-04b07c832676"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["x", 
      RowBox[{"\[ScriptL]", "+", "10"}]], "+", 
     SuperscriptBox["x", 
      RowBox[{
       RowBox[{"-", "\[ScriptL]"}], "-", "10"}]]}], 
    RowBox[{"1", "+", "x"}]], "//", 
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "2"}], "}"}]}], "]"}], "&"}]}], "//", 
  "Expand"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{"\[ScriptL]", ">", "0"}]}], "]"}], "&"}]}]}], "Input",
 CellChangeTimes->{{3.9980284509815083`*^9, 3.9980284747155952`*^9}, {
  3.998028517373646*^9, 3.998028522524996*^9}, {3.998028589454973*^9, 
  3.998028596943138*^9}},
 CellLabel->"In[286]:=",
 CellID->1121534538,ExpressionUUID->"9aa94416-7928-425c-b4c6-cf376a20de25"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["x", 
    RowBox[{
     RowBox[{"-", "10"}], "-", "\[ScriptL]"}]], " ", 
   RowBox[{"(", 
    InterpretationBox[
     RowBox[{"1", "-", "x", "+", 
      SuperscriptBox["x", "2"], "+", 
      InterpretationBox[
       SuperscriptBox[
        RowBox[{"O", "[", "x", "]"}], "3"],
       SeriesData[$CellContext`x, 0, {}, 0, 3, 1],
       Editable->False]}],
     SeriesData[$CellContext`x, 0, {1, -1, 1}, 0, 3, 1],
     Editable->False], ")"}]}], "+", 
  RowBox[{
   SuperscriptBox["x", 
    RowBox[{"10", "+", "\[ScriptL]"}]], " ", 
   RowBox[{"(", 
    InterpretationBox[
     RowBox[{"1", "-", "x", "+", 
      SuperscriptBox["x", "2"], "+", 
      InterpretationBox[
       SuperscriptBox[
        RowBox[{"O", "[", "x", "]"}], "3"],
       SeriesData[$CellContext`x, 0, {}, 0, 3, 1],
       Editable->False]}],
     SeriesData[$CellContext`x, 0, {1, -1, 1}, 0, 3, 1],
     Editable->False], ")"}]}]}]], "Output",
 CellChangeTimes->{{3.998028471878769*^9, 3.998028474884576*^9}, 
   3.9980285234948587`*^9, 3.9980285972167587`*^9},
 CellLabel->"Out[286]=",
 CellID->283964223,ExpressionUUID->"c66bf53f-b101-4cd1-89ae-ee4615099d07"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["x", 
   RowBox[{"-", "\[ScriptL]"}]], " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", 
    SuperscriptBox["x", 
     RowBox[{"20", "+", 
      RowBox[{"2", " ", "\[ScriptL]"}]}]]}], ")"}], " ", 
  RowBox[{"(", 
   InterpretationBox[
    RowBox[{
     FractionBox["1", 
      SuperscriptBox["x", "10"]], "-", 
     FractionBox["1", 
      SuperscriptBox["x", "9"]], "+", 
     FractionBox["1", 
      SuperscriptBox["x", "8"]], "+", 
     InterpretationBox[
      FractionBox["1", 
       SuperscriptBox[
        RowBox[{"O", "[", "x", "]"}], "7"]],
      SeriesData[$CellContext`x, 0, {}, -10, -7, 1],
      Editable->False]}],
    SeriesData[$CellContext`x, 0, {1, -1, 1}, -10, -7, 1],
    Editable->False], ")"}]}]], "Output",
 CellChangeTimes->{{3.998028471878769*^9, 3.998028474884576*^9}, 
   3.9980285234948587`*^9, 3.998028597239478*^9},
 CellLabel->"Out[287]=",
 CellID->556327281,ExpressionUUID->"c7535762-4100-4735-ab67-a4087b3ebd06"]
}, Open  ]],

