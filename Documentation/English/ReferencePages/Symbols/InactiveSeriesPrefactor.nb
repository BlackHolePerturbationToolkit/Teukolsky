Cell["\<\
SeriesData objects multiply factors onto every term in the series which can \
cause them to be very large \
\>", "ExampleText",
 CellChangeTimes->{{3.99796980941648*^9, 3.9979698865394907`*^9}},
 CellID->884594971,ExpressionUUID->"a21476d9-a800-46e2-932d-2a1ca919f2dc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   FractionBox[
    SuperscriptBox["x", "3"], 
    RowBox[{"x", "+", "1"}]], "//", 
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "15"}], "}"}]}], "]"}], "&"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"series", "=", 
  RowBox[{"%", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"y", "+", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["a", "2"], "-", "1"}]]}]], " "}]}]}], "Input",
 CellChangeTimes->{{3.9979697315387087`*^9, 3.997969846843122*^9}, {
  3.997969890776092*^9, 3.9979698993317833`*^9}},
 CellLabel->"In[174]:=",
