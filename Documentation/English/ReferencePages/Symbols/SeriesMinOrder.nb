 CellID->488187287,ExpressionUUID->"17231f52-f26c-44b8-b44b-b91454385dfb"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   SuperscriptBox["x", "4"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "x", "]"}], "5"],
    SeriesData[$CellContext`x, 0, {}, 4, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 0, {1}, 4, 5, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.998028389246879*^9, 3.998028393282343*^9}},
