Cell[BoxData[{
 RowBox[{
  FractionBox[
   SuperscriptBox["x", "4"], 
   RowBox[{"1", "+", "x"}]], "//", 
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{"#", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "4"}], "}"}]}], "]"}], 
   "&"}]}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "SeriesMinOrder"}]}], "Input",
