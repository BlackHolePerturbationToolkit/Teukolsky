Cell[BoxData[{
 RowBox[{
  FractionBox[
   SuperscriptBox["x", "4"], 
   RowBox[{"1", "+", "x"}]], "//", 
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{"#", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "10"}], "}"}]}], "]"}], 
   "&"}]}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "SeriesMaxOrder"}]}], "Input",
