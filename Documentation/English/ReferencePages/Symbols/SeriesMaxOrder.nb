 CellID->2055591665,ExpressionUUID->"5f88c434-1cae-49e3-971a-855476b43cab"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   SuperscriptBox["x", "4"], "-", 
   SuperscriptBox["x", "5"], "+", 
   SuperscriptBox["x", "6"], "-", 
   SuperscriptBox["x", "7"], "+", 
   SuperscriptBox["x", "8"], "-", 
   SuperscriptBox["x", "9"], "+", 
   SuperscriptBox["x", "10"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "x", "]"}], "11"],
    SeriesData[$CellContext`x, 0, {}, 4, 11, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 0, {1, -1, 1, -1, 1, -1, 1}, 4, 11, 1],
