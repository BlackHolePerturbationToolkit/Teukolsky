Cell[CellGroupData[{

Cell["Satisfying the angular Teukolsky equation analytically", \
"ExampleSubsection",
 CellChangeTimes->{{3.998472117385914*^9, 3.9984721328922863`*^9}},
 CellID->401919203,ExpressionUUID->"b46f7520-2263-4a5a-9001-6579bef99de2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", 
      RowBox[{"-", "2"}]}], ",", 
     RowBox[{"l", "=", "2"}], ",", 
     RowBox[{"m", "=", "2"}], ",", 
     RowBox[{"order", "=", "6"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"aux", ",", "TKR"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"aux", "=", 
       RowBox[{"RadialTeukolskyEquationPN", "[", 
        RowBox[{"s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", 
         RowBox[{"R", "[", "r", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Eta]", ",", 
           RowBox[{"order", "+", "10"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"TKR", "=", 
       RowBox[{"TeukolskyRadialPN", "[", 
        RowBox[{"s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", 
         RowBox[{"{", 
          RowBox[{"\[Eta]", ",", "order"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aux", "/.", 
       RowBox[{"R", "->", 
        RowBox[{"TKR", "[", "\"\<In\>\"", "]"}]}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.998472135215663*^9, 3.998472246326249*^9}},
 CellLabel->"In[11]:=",
