Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RadialTeukolskyEquationPN", "[", 
  RowBox[{"s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", 
   RowBox[{"R", "[", "r", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Eta]", ",", "5"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.998472092485277*^9, 3.9984721064688673`*^9}},
 CellLabel->"In[9]:=",
 CellID->1659673413,ExpressionUUID->"576584ad-a858-4620-90ef-7dbaadb505ec"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "l"}], "-", 
        SuperscriptBox["l", "2"], "+", "s", "+", 
        SuperscriptBox["s", "2"]}], ")"}], " ", 
      RowBox[{"R", "[", "r", "]"}]}], "+", 
     RowBox[{"2", " ", "r", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "s"}], ")"}], " ", 
      RowBox[{
       SuperscriptBox["R", "\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["r", "2"], " ", 
      RowBox[{
       SuperscriptBox["R", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}]}], ")"}], "+", 
   RowBox[{
   "2", " ", "\[ImaginaryI]", " ", "r", " ", "s", " ", "\[Omega]", " ", 
    RowBox[{"R", "[", "r", "]"}], " ", "\[Eta]"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "a", " ", "m", " ", "s"}], 
          "+", 
          RowBox[{
           SuperscriptBox["r", "3"], " ", 
           SuperscriptBox["\[Omega]", "2"]}]}], ")"}], " ", 
        RowBox[{"R", "[", "r", "]"}]}], "r"], "-", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "s"}], ")"}], " ", 
       RowBox[{
        SuperscriptBox["R", "\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}], "-", 
      RowBox[{"2", " ", "r", " ", 
       RowBox[{
        SuperscriptBox["R", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}]}], ")"}], " ", 
    SuperscriptBox["\[Eta]", "2"]}], "+", 
   FractionBox[
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "l", " ", "s", " ", "\[Omega]"}],
        "-", 
       RowBox[{"\[ImaginaryI]", " ", 
        SuperscriptBox["l", "2"], " ", "s", " ", "\[Omega]"}], "+", 
       RowBox[{"a", " ", "m", " ", 
        SuperscriptBox["s", "2"], " ", "\[Omega]"}]}], ")"}], " ", 
     RowBox[{"R", "[", "r", "]"}], " ", 
     SuperscriptBox["\[Eta]", "3"]}], 
    RowBox[{"l", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "l"}], ")"}]}]], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["m", "2"]}], "+", 
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "a", " ", "m", " ", "s"}], 
          "+", 
          RowBox[{"2", " ", 
           SuperscriptBox["r", "3"], " ", 
           SuperscriptBox["\[Omega]", "2"]}]}], ")"}], " ", 
        RowBox[{"R", "[", "r", "]"}]}], 
       SuperscriptBox["r", "2"]], "+", 
      RowBox[{
       SuperscriptBox["a", "2"], " ", 
       RowBox[{
        SuperscriptBox["R", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}]}], ")"}], " ", 
    SuperscriptBox["\[Eta]", "4"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Eta]", "]"}], "5"],
    SeriesData[$CellContext`\[Eta], 0, {}, 0, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Eta], 
   0, {(-$CellContext`l - $CellContext`l^2 + $CellContext`s + \
$CellContext`s^2) $CellContext`R[$CellContext`r] + 
    2 $CellContext`r (1 + $CellContext`s) 
     Derivative[1][$CellContext`R][$CellContext`r] + $CellContext`r^2 
     Derivative[2][$CellContext`R][$CellContext`r], 
    Complex[0, 
      2] $CellContext`r $CellContext`s $CellContext`\[Omega] \
$CellContext`R[$CellContext`r], $CellContext`r^(-1) (
      Complex[0, 
         2] $CellContext`a $CellContext`m $CellContext`s + $CellContext`r^3 \
$CellContext`\[Omega]^2) $CellContext`R[$CellContext`r] - 
    2 (1 + $CellContext`s) Derivative[1][$CellContext`R][$CellContext`r] - 
    2 $CellContext`r Derivative[2][$CellContext`R][$CellContext`r], 
    2 $CellContext`l^(-1) (1 + $CellContext`l)^(-1) (
     Complex[0, -1] $CellContext`l $CellContext`s $CellContext`\[Omega] + 
     Complex[
       0, -1] $CellContext`l^2 $CellContext`s $CellContext`\[Omega] + \
$CellContext`a $CellContext`m $CellContext`s^2 $CellContext`\[Omega]) \
$CellContext`R[$CellContext`r], $CellContext`r^(-2) ($CellContext`a^2 \
$CellContext`m^2 + Complex[0, 2] $CellContext`a $CellContext`m $CellContext`s + 
      2 $CellContext`r^3 $CellContext`\[Omega]^2) \
$CellContext`R[$CellContext`r] + $CellContext`a^2 
     Derivative[2][$CellContext`R][$CellContext`r]}, 0, 5, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.998472106819001*^9},
 CellLabel->"Out[9]=",
 CellID->687876310,ExpressionUUID->"682bc821-3d55-462e-9f2a-aa20734ff5dd"]
}, Open  ]]
