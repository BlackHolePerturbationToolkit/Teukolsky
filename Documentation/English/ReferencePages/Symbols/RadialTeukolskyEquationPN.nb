Cell["\<\
RadialTeukolskyEquationPN returns the PN expanded radial Teukolsky equation\
\>", "ExampleText",
 CellChangeTimes->{{3.998034335220087*^9, 3.998034347051835*^9}},
 CellID->282005857,ExpressionUUID->"a659b62f-3996-44d9-b4b0-3dd774e3b0ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RadialTeukolskyEquationPN", "[", 
  RowBox[{"s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", 
   RowBox[{"R", "[", "r", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Eta]", ",", "4"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.998033986176155*^9, 3.998034005643772*^9}},
 CellLabel->"In[407]:=",
 CellID->1235537669,ExpressionUUID->"bb77f5bc-deff-4f25-a72c-4d1585489be5"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "l"}], "-", 
        SuperscriptBox["l", "2"], "+", "s", "+", 
        SuperscriptBox["s", "2"]}], ")"}], " ", 
      RowBox[{"R", "[", "r", "]"}]}], "+", 
     RowBox[{"2", " ", "r", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "s"}], ")"}], " ", 
      RowBox[{
       SuperscriptBox["R", "\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["r", "2"], " ", 
      RowBox[{
       SuperscriptBox["R", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}]}], ")"}], "+", 
   RowBox[{
   "2", " ", "\[ImaginaryI]", " ", "r", " ", "s", " ", "\[Omega]", " ", 
    RowBox[{"R", "[", "r", "]"}], " ", "\[Eta]"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "a", " ", "m", " ", "s"}], 
          "+", 
          RowBox[{
           SuperscriptBox["r", "3"], " ", 
           SuperscriptBox["\[Omega]", "2"]}]}], ")"}], " ", 
        RowBox[{"R", "[", "r", "]"}]}], "r"], "-", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "s"}], ")"}], " ", 
       RowBox[{
        SuperscriptBox["R", "\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}], "-", 
      RowBox[{"2", " ", "r", " ", 
       RowBox[{
        SuperscriptBox["R", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}]}], ")"}], " ", 
    SuperscriptBox["\[Eta]", "2"]}], "+", 
   FractionBox[
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "l", " ", "s", " ", "\[Omega]"}],
        "-", 
       RowBox[{"\[ImaginaryI]", " ", 
        SuperscriptBox["l", "2"], " ", "s", " ", "\[Omega]"}], "+", 
       RowBox[{"a", " ", "m", " ", 
        SuperscriptBox["s", "2"], " ", "\[Omega]"}]}], ")"}], " ", 
     RowBox[{"R", "[", "r", "]"}], " ", 
     SuperscriptBox["\[Eta]", "3"]}], 
    RowBox[{"l", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "l"}], ")"}]}]], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Eta]", "]"}], "4"],
    SeriesData[$CellContext`\[Eta], 0, {}, 0, 4, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Eta], 
   0, {(-$CellContext`l - $CellContext`l^2 + $CellContext`s + \
$CellContext`s^2) $CellContext`R[$CellContext`r] + 
    2 $CellContext`r (1 + $CellContext`s) 
     Derivative[1][$CellContext`R][$CellContext`r] + $CellContext`r^2 
     Derivative[2][$CellContext`R][$CellContext`r], 
    Complex[0, 
      2] $CellContext`r $CellContext`s $CellContext`\[Omega] \
$CellContext`R[$CellContext`r], $CellContext`r^(-1) (
      Complex[0, 
         2] $CellContext`a $CellContext`m $CellContext`s + $CellContext`r^3 \
$CellContext`\[Omega]^2) $CellContext`R[$CellContext`r] - 
    2 (1 + $CellContext`s) Derivative[1][$CellContext`R][$CellContext`r] - 
    2 $CellContext`r Derivative[2][$CellContext`R][$CellContext`r], 
    2 $CellContext`l^(-1) (1 + $CellContext`l)^(-1) (
     Complex[0, -1] $CellContext`l $CellContext`s $CellContext`\[Omega] + 
     Complex[0, -1] $CellContext`l^2 $CellContext`s $CellContext`\[Omega] + \
$CellContext`a $CellContext`m $CellContext`s^2 $CellContext`\[Omega]) \
$CellContext`R[$CellContext`r]}, 0, 4, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.998033989420169*^9, 3.998034005905262*^9}},
 CellLabel->"Out[407]=",
 CellID->19911986,ExpressionUUID->"43ae60c0-fcdd-49f2-a7d4-8cff48c79129"]
}, Open  ]],

Cell["We can check that our solutions satisfy it ", "ExampleText",
 CellChangeTimes->{{3.998034349439114*^9, 3.998034358026828*^9}},
 CellID->2012566823,ExpressionUUID->"5b0481d4-dabe-4833-9020-cc9af86343ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", 
      RowBox[{"-", "2"}]}], ",", 
     RowBox[{"l", "=", "2"}], ",", 
     RowBox[{"m", "=", "2"}], ",", 
     RowBox[{"sol", "=", "\"\<In\>\""}], ",", 
     RowBox[{"order", "=", "5"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"aux", ",", "TKR"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"aux", "=", 
       RowBox[{"RadialTeukolskyEquationPN", "[", 
        RowBox[{"s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", 
         RowBox[{"R", "[", "r", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Eta]", ",", 
           RowBox[{"order", "+", "20"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"TKR", "=", 
       RowBox[{
        RowBox[{"TeukolskyRadialPN", "[", 
         RowBox[{"s", ",", "l", ",", "m", ",", "a", ",", "\[Omega]", ",", 
          RowBox[{"{", 
           RowBox[{"\[Eta]", ",", "order"}], "}"}]}], "]"}], "[", "sol", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"aux", "/.", 
       RowBox[{"R", "->", "TKR"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.998033739027176*^9, 3.9980338941884747`*^9}, {
  3.9980340134411077`*^9, 3.998034087719695*^9}, {3.9980341675118837`*^9, 
  3.998034173878845*^9}, {3.998034254258058*^9, 3.998034297246241*^9}},
 CellLabel->"In[414]:=",
 CellID->617728407,ExpressionUUID->"726ca8fc-c7fa-460b-9aca-ac5809a45d17"],

Cell[BoxData[
 InterpretationBox[
  SuperscriptBox[
   RowBox[{"O", "[", "\[Eta]", "]"}], "9"],
  SeriesData[$CellContext`\[Eta], 0, {}, 9, 9, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.998034056314026*^9, 3.998034096825671*^9}, 
   3.998034183613757*^9, 3.998034263354658*^9, {3.9980342940221243`*^9, 
   3.998034306581606*^9}},
 CellLabel->"Out[414]=",
 CellID->1467963122,ExpressionUUID->"8355925e-0d9f-4ac7-ab3a-b8f63aa7dcb3"]
}, Open  ]]
}, Open  ]],

