Cell["The function gives the PN expanded Teukolsky equation", "ExampleText",
 CellChangeTimes->{{3.980326551976231*^9, 3.980326564912815*^9}},
 CellID->1389067111,ExpressionUUID->"a8a97fed-03a0-45d4-a379-d5b5d76c0401"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RadialTeukolskyEquationPN", "[", 
  RowBox[{
  "\[ScriptS]", ",", "\[ScriptL]", ",", "\[ScriptM]", ",", "a", ",", 
   "\[Omega]", ",", 
   RowBox[{"R", "[", "r", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Eta]", ",", "4"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[58]:=",
 CellID->1286719222,ExpressionUUID->"7020e846-0066-44df-98d5-28bb9cfc6de4"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "\[ScriptL]"}], "-", 
        SuperscriptBox["\[ScriptL]", "2"], "+", "\[ScriptS]", "+", 
        SuperscriptBox["\[ScriptS]", "2"]}], ")"}], " ", 
      RowBox[{"R", "[", "r", "]"}]}], "+", 
     RowBox[{"2", " ", "r", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "\[ScriptS]"}], ")"}], " ", 
      RowBox[{
       SuperscriptBox["R", "\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["r", "2"], " ", 
      RowBox[{
       SuperscriptBox["R", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}]}], ")"}], "+", 
   RowBox[{
   "2", " ", "\[ImaginaryI]", " ", "r", " ", "\[ScriptS]", " ", "\[Omega]", 
    " ", 
    RowBox[{"R", "[", "r", "]"}], " ", "\[Eta]"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "2", " ", "\[ImaginaryI]", " ", "a", " ", "\[ScriptM]", " ", 
           "\[ScriptS]"}], "+", 
          RowBox[{
           SuperscriptBox["r", "3"], " ", 
           SuperscriptBox["\[Omega]", "2"]}]}], ")"}], " ", 
        RowBox[{"R", "[", "r", "]"}]}], "r"], "-", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[ScriptS]"}], ")"}], " ", 
       RowBox[{
        SuperscriptBox["R", "\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}], "-", 
      RowBox[{"2", " ", "r", " ", 
       RowBox[{
        SuperscriptBox["R", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}]}], ")"}], " ", 
    SuperscriptBox["\[Eta]", "2"]}], "+", 
   FractionBox[
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[ScriptL]", " ", "\[ScriptS]", 
        " ", "\[Omega]"}], "-", 
       RowBox[{"\[ImaginaryI]", " ", 
        SuperscriptBox["\[ScriptL]", "2"], " ", "\[ScriptS]", " ", 
        "\[Omega]"}], "+", 
       RowBox[{"a", " ", "\[ScriptM]", " ", 
        SuperscriptBox["\[ScriptS]", "2"], " ", "\[Omega]"}]}], ")"}], " ", 
     RowBox[{"R", "[", "r", "]"}], " ", 
     SuperscriptBox["\[Eta]", "3"]}], 
    RowBox[{"\[ScriptL]", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "\[ScriptL]"}], ")"}]}]], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Eta]", "]"}], "4"],
    SeriesData[$CellContext`\[Eta], 0, {}, 0, 4, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Eta], 
   0, {(-$CellContext`\[ScriptL] - $CellContext`\[ScriptL]^2 + $CellContext`\
\[ScriptS] + $CellContext`\[ScriptS]^2) $CellContext`R[$CellContext`r] + 
    2 $CellContext`r (1 + $CellContext`\[ScriptS]) 
     Derivative[1][$CellContext`R][$CellContext`r] + $CellContext`r^2 
     Derivative[2][$CellContext`R][$CellContext`r], 
    Complex[0, 
      2] $CellContext`r $CellContext`\[ScriptS] $CellContext`\[Omega] \
$CellContext`R[$CellContext`r], $CellContext`r^(-1) (
      Complex[0, 
         2] $CellContext`a $CellContext`\[ScriptM] $CellContext`\[ScriptS] + \
$CellContext`r^3 $CellContext`\[Omega]^2) $CellContext`R[$CellContext`r] - 
    2 (1 + $CellContext`\[ScriptS]) 
    Derivative[1][$CellContext`R][$CellContext`r] - 2 $CellContext`r 
    Derivative[2][$CellContext`R][$CellContext`r], 
    2 $CellContext`\[ScriptL]^(-1) (1 + $CellContext`\[ScriptL])^(-1) (
     Complex[0, -1] $CellContext`\[ScriptL] $CellContext`\[ScriptS] \
$CellContext`\[Omega] + 
     Complex[0, -1] $CellContext`\[ScriptL]^2 $CellContext`\[ScriptS] \
$CellContext`\[Omega] + $CellContext`a $CellContext`\[ScriptM] $CellContext`\
\[ScriptS]^2 $CellContext`\[Omega]) $CellContext`R[$CellContext`r]}, 0, 4, 1],
  
  Editable->False]], "Output",
 CellChangeTimes->{3.9803265788752947`*^9},
 CellLabel->"Out[58]=",
 CellID->1432278557,ExpressionUUID->"93492885-a8dc-4c1a-8d27-f500782e49c6"]
}, Open  ]],

Cell["We can use it to check our solutions", "ExampleText",
 CellChangeTimes->{{3.980326567325976*^9, 3.980326574244844*^9}},
 CellID->728422692,ExpressionUUID->"f0e6ec5f-610f-4244-a0e5-4d9f20ad5412"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[ScriptS]", "=", 
      RowBox[{"-", "2"}]}], ",", 
     RowBox[{"\[ScriptL]", "=", "2"}], ",", 
     RowBox[{"\[ScriptM]", "=", "2"}], ",", 
     RowBox[{"order", "=", "5"}], ",", 
     RowBox[{"side", "=", "\"\<Up\>\""}], ",", "\[Eta]", ",", "a", ",", 
     "\[Omega]", ",", "R", ",", "r", ",", "solution", ",", "equation"}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"equation", "=", 
     RowBox[{"RadialTeukolskyEquationPN", "[", 
      RowBox[{
      "\[ScriptS]", ",", "\[ScriptL]", ",", "\[ScriptM]", ",", "a", ",", 
       "\[Omega]", ",", 
       RowBox[{"R", "[", "r", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Eta]", ",", 
         RowBox[{"order", "+", "10"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"solution", "=", 
     RowBox[{
      RowBox[{"TeukolskyRadialPN", "[", 
       RowBox[{
       "\[ScriptS]", ",", "\[ScriptL]", ",", "\[ScriptM]", ",", "a", ",", 
        "\[Omega]", ",", 
        RowBox[{"{", 
         RowBox[{"\[Eta]", ",", "order"}], "}"}]}], "]"}], "[", "side", 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"equation", "/.", 
     RowBox[{"R", "->", "solution"}]}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.9803254731583357`*^9, 3.9803256622535152`*^9}, {
  3.980326334571006*^9, 3.980326348882563*^9}, {3.980326394101351*^9, 
  3.980326492290262*^9}, {3.9803265336947412`*^9, 3.980326533950677*^9}},
 CellLabel->"In[59]:=",
 CellID->1451980228,ExpressionUUID->"b95bc235-9aac-40f7-a58c-65793a1b0e4c"],

Cell[BoxData[
 InterpretationBox[
  SuperscriptBox[
   RowBox[{"O", "[", "\[Eta]", "]"}], "4"],
  SeriesData[$CellContext`\[Eta], 0, {}, 4, 4, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.980326591704363*^9},
 CellLabel->"Out[59]=",
 CellID->220538441,ExpressionUUID->"11855da5-2e3e-4c7e-9b57-ee956a764d32"]
}, Open  ]]
}, Open  ]],

