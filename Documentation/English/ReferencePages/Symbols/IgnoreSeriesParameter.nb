  RowBox[{
   ButtonBox["IgnoreSeriesParameter",
    BaseStyle->"Link",
    ButtonData->"paclet:TeukolskyPNTools/ref/IgnoreSeriesParameter"], "[", 
   RowBox[{
    StyleBox["series", "TI"], ",", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a7478d04-82b6-4b01-a0dc-b81cb538769b"],
