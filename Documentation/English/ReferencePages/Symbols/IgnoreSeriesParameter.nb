     RowBox[{"O", "[", "\[Gamma]", "]"}], "5"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 0, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 0, {
