Cell["\<\
Having the Expansion parameter in the coefficients of the Series can cause \
problems, e.g., when importing expressions. This can be circumvented with \
IgnoreSeriesParameter\
\>", "ExampleText",
 CellChangeTimes->{{3.997970204862891*^9, 3.997970236277001*^9}, {
  3.9979703588385067`*^9, 3.99797038712538*^9}},
 CellID->1154705918,ExpressionUUID->"926779ee-ff17-48ce-b6cf-71532fc642b4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  FractionBox[
   RowBox[{"Log", "[", 
    RowBox[{"\[Gamma]", " ", "\[Omega]"}], "]"}], 
   RowBox[{"1", "+", "\[Gamma]"}]], "//", 
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{"#", ",", 
     RowBox[{"{", 
      RowBox[{"\[Gamma]", ",", "0", ",", "4"}], "}"}]}], "]"}], 
   "&"}]}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "IgnoreSeriesParameter"}]}], "Input",
 CellChangeTimes->{{3.997970390010338*^9, 3.997970417035263*^9}},
 CellLabel->"In[211]:=",
