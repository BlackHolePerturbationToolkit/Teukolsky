Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"Sin", "[", "a", "]"}], 
      RowBox[{"(", 
       RowBox[{"a", "+", "b", "+", "c", "+", "d"}], ")"}]}], 
     RowBox[{"1", "+", "x"}]], "//", "Expand"}], "//", 
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "4"}], "}"}]}], "]"}], "&"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"SeriesMap", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Collect", "[", 
      RowBox[{"#", ",", 
       RowBox[{"Sin", "[", "a", "]"}]}], "]"}], "&"}], ")"}], ",", "%"}], 
  "]"}]}], "Input",
