Cell["Internally SeriesCollect acts as a shortcut to SeriesMap", "ExampleText",
 CellChangeTimes->{{3.99802808490306*^9, 3.998028103140716*^9}, {
  3.998028139797201*^9, 3.9980281554099913`*^9}},
