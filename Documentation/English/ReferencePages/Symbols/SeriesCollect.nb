Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", "+", "b", "+", "c", "+", "d"}], ")"}], " ", 
    RowBox[{"Sin", "[", "a", "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
