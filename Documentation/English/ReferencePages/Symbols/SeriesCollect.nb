Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", "+", "b", "+", "c", "+", "d"}], ")"}], " ", 
    RowBox[{"Sin", "[", "a", "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "a"}], "-", "b", "-", "c", "-", "d"}], ")"}], " ", 
    RowBox[{"Sin", "[", "a", "]"}], " ", "x"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", "+", "b", "+", "c", "+", "d"}], ")"}], " ", 
    RowBox[{"Sin", "[", "a", "]"}], " ", 
    SuperscriptBox["x", "2"]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "a"}], "-", "b", "-", "c", "-", "d"}], ")"}], " ", 
    RowBox[{"Sin", "[", "a", "]"}], " ", 
    SuperscriptBox["x", "3"]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", "+", "b", "+", "c", "+", "d"}], ")"}], " ", 
    RowBox[{"Sin", "[", "a", "]"}], " ", 
    SuperscriptBox["x", "4"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "x", "]"}], "5"],
    SeriesData[$CellContext`x, 0, {}, 0, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 
   0, {($CellContext`a + $CellContext`b + $CellContext`c + $CellContext`d) 
    Sin[$CellContext`a], (-$CellContext`a - $CellContext`b - $CellContext`c - \
$CellContext`d) 
