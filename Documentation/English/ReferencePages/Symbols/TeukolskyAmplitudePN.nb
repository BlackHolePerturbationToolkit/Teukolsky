Cell["\<\
Plugging in specific values can be fiddly as a simple replacement might \
introduce intermediate but canceling divergencies. Mapping a second Series \
onto the series coefficients handles these automatically. \
\>", "ExampleText",
 CellChangeTimes->{{3.9771255021190166`*^9, 3.977125575330132*^9}},
 CellID->436049597,ExpressionUUID->"1efa214f-2134-4b99-b201-66185c0f773e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Normal", "[", "#", "]"}], "&"}], "/@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Series", "[", 
       RowBox[{"#", ",", 
        RowBox[{"\[ScriptL]", "->", "5"}]}], "]"}], "&"}], "/@", 
     RowBox[{"(", 
      RowBox[{"testGeneric\[ScriptL]", "/.", 
       RowBox[{"{", 
        RowBox[{"\[ScriptM]", "->", "2"}], "}"}]}], ")"}]}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"testSpecific\[ScriptL]", "-", "%"}]}], "Input",
 CellChangeTimes->{{3.9771253368080263`*^9, 3.977125497056355*^9}},
 CellLabel->"In[44]:=",
 CellID->1590508261,ExpressionUUID->"4a838f66-22cc-4455-ac54-51f9c960073e"],

Cell[BoxData[
 InterpretationBox[
  SuperscriptBox[
   RowBox[{"O", "[", "\[Gamma]", "]"}], "8"],
  SeriesData[$CellContext`\[Gamma], 0, {}, 8, 8, 1],
  Editable->False]], "Output",
 CellChangeTimes->{
  3.977125347281659*^9, {3.977125384640781*^9, 3.977125393010419*^9}, 
   3.977125451265668*^9, {3.9771254840452137`*^9, 3.977125498489443*^9}},
 CellLabel->"Out[45]=",
 CellID->415786673,ExpressionUUID->"e2814104-9b65-4d2f-8350-a77bfbb9247c"]
}, Open  ]],

