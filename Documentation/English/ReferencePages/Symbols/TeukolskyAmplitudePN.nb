Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"-", 
    RowBox[{"2", " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Omega]", "3"], " ", 
     SuperscriptBox["\[Gamma]", "3"]}]}], "+", 
