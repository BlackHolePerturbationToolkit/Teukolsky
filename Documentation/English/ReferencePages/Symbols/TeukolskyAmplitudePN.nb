Cell[TextData[{
 "The Normalization option allows to change the respective normalization of \
",
 Cell[BoxData[
  SubscriptBox["R", "In"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "c843e20f-6efc-46e9-97e9-a226e7bb7f4d"],
 " and ",
 Cell[BoxData[
  SubscriptBox["R", "Up"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "c488af4f-60c8-4996-90f5-ae0ff05a06eb"],
 " . Note that the Option needs to be specified in the first bracket."
}], "ExampleText",
 CellChangeTimes->{{3.9746991106586103`*^9, 3.974699175913659*^9}},
 CellID->1293686612,ExpressionUUID->"e739619f-6378-460a-8e13-4a52c2413589"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"TeukolskyAmplitudePN", "[", 
   RowBox[{"\"\<Btrans\>\"", ",", 
    RowBox[{"\"\<Normalization\>\"", "->", "\"\<UnitTransmission\>\""}]}], 
   "]"}], "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
   RowBox[{"{", 
    RowBox[{"\[Gamma]", ",", "2"}], "}"}]}], "]"}]], "Input",
