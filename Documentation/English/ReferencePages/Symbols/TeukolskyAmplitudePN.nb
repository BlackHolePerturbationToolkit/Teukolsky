Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TeukolskyAmplitudePN", "[", 
    RowBox[{"\"\<Btrans\>\"", ",", 
     RowBox[{"\"\<Normalization\>\"", "->", "\"\<SasakiTagoshi\>\""}]}], 
    "]"}], "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]", ",", "2"}], "}"}]}], "]"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.974699178556306*^9, 3.974699236700612*^9}},
 CellLabel->"In[29]:=",
 CellID->1115033394,ExpressionUUID->"f31205f1-b8c1-4046-9b09-07f53405afcc"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox[
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "a", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", 
           SuperscriptBox["a", "2"]}], "]"}], 
         RowBox[{"1", "+", 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}]]}]]}], ")"}]}]], 
    RowBox[{"16", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["a", "2"]}], ")"}], "2"]}]], "+", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "a", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"Log", "[", 
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}], "]"}], 
          RowBox[{"1", "+", 
           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["a", "2"]}]]}]]}], ")"}]}]], " ", "\[Omega]", " ", 
     RowBox[{"(", 
      RowBox[{"9", "+", 
       RowBox[{"10", " ", "\[ImaginaryI]", " ", "a"}], "+", 
       RowBox[{"24", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}]]}], "+", 
       RowBox[{"9", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}], "]"}]}]}], ")"}], " ", "\[Gamma]"}], 
    RowBox[{"144", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["a", "2"]}], ")"}], "2"]}]], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Gamma]", "]"}], "2"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 0, {
   Rational[1, 16] (-1 + $CellContext`a^2)^(-2) 
    E^(Complex[0, -1] $CellContext`a (
       1 + (1 + (1 - $CellContext`a^2)^Rational[1, 2])^(-1) 
        Log[1 - $CellContext`a^2])), Complex[0, 
      Rational[1, 144]] (-1 + $CellContext`a^2)^(-2) 
    E^(Complex[0, -1] $CellContext`a (
       1 + (1 + (1 - $CellContext`a^2)^Rational[1, 2])^(-1) 
        Log[1 - $CellContext`a^2])) $CellContext`\[Omega] (9 + 
     Complex[0, 10] $CellContext`a + 24 (1 - $CellContext`a^2)^Rational[1, 2] + 
     9 Log[1 - $CellContext`a^2])}, 0, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.974699232524495*^9, 3.9746992369996777`*^9}, 
   3.9937446137319736`*^9},
 CellLabel->"Out[29]=",
 CellID->1021114217,ExpressionUUID->"5cfbdcd7-bf04-46c8-ae1f-6b2154011a7d"]
}, Open  ]],

