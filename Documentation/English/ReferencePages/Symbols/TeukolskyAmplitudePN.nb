Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"-", 
    RowBox[{"2", " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Omega]", "3"], " ", 
     SuperscriptBox["\[Eta]", "9"]}]}], "+", 
   RowBox[{
    FractionBox["2", "9"], " ", 
    SuperscriptBox["\[Omega]", "4"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "9"}], "-", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], "+", 
      RowBox[{"6", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}]]}], "+", 
      RowBox[{"9", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "+", 
      RowBox[{"18", " ", 
       RowBox[{"Log", "[", "2", "]"}]}], "+", 
      RowBox[{"18", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"2", " ", "\[Omega]"}], "]"}]}]}], ")"}], " ", 
    SuperscriptBox["\[Eta]", "12"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Eta]", "]"}], "15"],
    SeriesData[$CellContext`\[Eta], 0, {}, 9, 15, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Eta], 0, {
   Complex[0, -2] $CellContext`\[Omega]^3, 0, 0, 
    Rational[2, 9] $CellContext`\[Omega]^4 (-9 + 
     Complex[0, -2] $CellContext`a + 6 (1 - $CellContext`a^2)^Rational[1, 2] + 
     Complex[0, 9] Pi + 18 Log[2] + 18 Log[2 $CellContext`\[Omega]])}, 9, 15, 
   1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.974699840390328*^9, 3.9746998492870607`*^9}},
 CellLabel->"Out[56]=",
