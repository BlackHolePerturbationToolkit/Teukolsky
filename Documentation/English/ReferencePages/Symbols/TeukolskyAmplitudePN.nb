Cell["The following options can be given: ", "Notes",
 CellID->1619706067,ExpressionUUID->"cced8099-8eaa-4ed3-8f4a-3645fa9da328"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d704688e-f992-4c33-a562-568475acf30f"], "\"\<Normalization\>\"", 
    "\"\<Default\>\"", Cell[TextData[Cell[BoxData[Cell[TextData[{
      "The normalization for the In and Up solution and corresponding \
amplitudes. The \"Default\" option is geared towards efficiency. \
\"SasakiTagoshi\" gives the normalizations used in arxiv:0306120. \
\"TidalResponse\"gives the old default used in Teukolsky` version 1.1 and \
1.1.1. \"UnitTransmission\" makes it such that the transmission coefficients \
are 1. This is also the normalization used in ",
      Cell[BoxData[
       ButtonBox["TeukolskyRadial",
        BaseStyle->"Link",
        ButtonData->"paclet:Teukolsky/ref/TeukolskyRadial"]], "InlineFormula",
       ExpressionUUID->"3443c164-21c2-49ba-9ef6-205931ae1295"],
      " (no PN). "
     }], "TableText",ExpressionUUID->"50188943-7714-414f-84fe-53ce96508cae"]],
      "3ColumnTableMod",
     CellChangeTimes->{{3.942226969137558*^9, 3.9422269693066587`*^9}, {
       3.942227056880557*^9, 3.942227076988049*^9}, 3.9422271393781767`*^9, {
       3.942227185895194*^9, 3.94222734696238*^9}, {3.942229499518452*^9, 
       3.94222955524142*^9}, {3.942230656164405*^9, 3.94223066232033*^9}, {
       3.942230809279039*^9, 3.942230938905239*^9}, {3.942230975767381*^9, 
       3.942230990215602*^9}, {3.946986561540934*^9, 
       3.9469865656218557`*^9}, {3.947075893567389*^9, 
       3.947075942085696*^9}, {3.977119856962031*^9, 3.977119957019212*^9}, 
       3.977120057651574*^9},ExpressionUUID->
     "29ab4813-d96a-430f-8af2-19c473a0c83f"]], "TableText",ExpressionUUID->
     "621f802a-568f-4748-87d2-eea94d446fe5"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4d7d1d54-26c7-40e8-b670-40e76035e6ad"], "\"\<FreqRep\>\"", 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "Changes how to scale \[Omega]. If set to one it expands linarly in by ",
     
     Cell[BoxData[
      RowBox[{"\[Omega]", "->", 
       RowBox[{"\[Gamma]", " ", "\[Omega]"}]}]], "InlineFormula",
      ExpressionUUID->"ac0cf973-3c76-41fd-b6e6-c75e57d3408c"],
     ". If set to False it will expand ",
     Cell[BoxData[
      RowBox[{"\[Omega]", "->", 
       RowBox[{
        SuperscriptBox["\[Eta]", "3"], " ", "\[Omega]"}]}]], "InlineFormula",
      ExpressionUUID->"a9344a0e-adda-4489-bbe1-b6231543fe08"],
     ". The second case in less readable, but compatible with the PN scalings \
used in TeukolskyRadialPN, where the presence of r matters."
    }], "TableText",ExpressionUUID->"85a56baf-7a18-414d-ab98-4aaece3308cf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "331a447f-93bc-4bce-9268-c862bb02d9ac"], "\"\<Simplify\>\"", "False", 
    Cell["\<\
Setting \"Simplify\" to True performs simplifications but takes longer\
\>", "TableText",ExpressionUUID->"d4f7b451-aac4-4d65-ab4a-806d073442a9"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{3.974698676675323*^9, 3.974698694372819*^9}, {
  3.974698763634233*^9, 3.974698768487443*^9}, {3.977122375594296*^9, 
