Cell[CellGroupData[{

Cell["Checking against numerics", "ExampleSubsection",
 CellChangeTimes->{3.9747150631951523`*^9},
 CellID->1228005106,ExpressionUUID->"d7cda89e-1aa4-4c77-9d2e-92eabcc01c20"],

Cell[TextData[{
 "We numerically check against the toolkit. The plot shows the relative error \
of ",
 Cell[BoxData[
  SubscriptBox["B", "inc"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "5084e0aa-7068-48cb-a222-995e93fc5bc1"],
 " on a field of \[Omega] and 1-a. Note that  in order to compare with the \
numerics we need to choose the \"UnitTransmission\" option for \
\"Normalization\". Feel free to change the values specified in the Module"
}], "ExampleText",
 CellChangeTimes->{{3.9747151496650968`*^9, 3.974715162755101*^9}, {
  3.974716248625088*^9, 3.974716309333869*^9}, {3.974716354417869*^9, 
  3.974716372774441*^9}, {3.993051094711471*^9, 3.9930511265066843`*^9}, {
  3.993051159830694*^9, 3.993051163645186*^9}},
 CellID->2051354177,ExpressionUUID->"dbe850d1-812a-4e07-98b2-d9a3a314d67d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"logTicks", "[", 
    RowBox[{"min_", ",", "max_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Superscript", "[", 
        RowBox[{"10", ",", "i"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Floor", "[", "min", "]"}], ",", 
       RowBox[{"Ceiling", "[", "max", "]"}]}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"EchoTiming", "[", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s", "=", 
       RowBox[{"-", "2"}]}], ",", 
      RowBox[{"\[ScriptL]", "=", "2"}], ",", 
      RowBox[{"m", "=", "2"}], ",", 
      RowBox[{"prec", "=", "100"}], ",", 
      RowBox[{"\[Omega]min", "=", "0.00001"}], ",", 
      RowBox[{"\[Omega]max", "=", "0.1"}], ",", 
      RowBox[{"points\[Omega]", "=", "15"}], ",", 
      RowBox[{"amin", "=", "0"}], ",", 
      RowBox[{"amax", "=", "0.999999"}], ",", 
      RowBox[{"pointsa", "=", "15"}], ",", "\[Kappa]s", ",", "as", ",", 
      RowBox[{"order", "=", "5"}], ",", "plot", ",", "Rin", ",", "Amp", ",", 
      "Rup", ",", "rs", ",", "\[Omega]s", ",", "aux", ",", "auxN", ",", 
      "auxPN", ",", "TKRPN", ",", "Bref", ",", "Binc", ",", "Cref", ",", 
      "Cinc", ",", "TKR"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "amax"}], "]"}], ",", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "amin"}], "]"}], ",", "pointsa"}], "]"}], "//", 
       "Exp"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"1", "-", "as"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Omega]s", "=", 
      RowBox[{
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"Log", "[", "\[Omega]min", "]"}], ",", 
         RowBox[{"Log", "[", "\[Omega]max", "]"}], ",", "points\[Omega]"}], 
        "]"}], "//", "Exp"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"TKR", "[", 
           RowBox[{"\[Omega]", ",", "a"}], "]"}], "=", 
          RowBox[{"TeukolskyRadial", "[", 
           RowBox[{"s", ",", "\[ScriptL]", ",", "m", ",", 
            RowBox[{"SetPrecision", "[", 
             RowBox[{"a", ",", "prec"}], "]"}], ",", 
            RowBox[{"SetPrecision", "[", 
             RowBox[{"\[Omega]", ",", "prec"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Omega]", ",", "\[Omega]s"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "as"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Amp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"TeukolskyAmplitudePN", "[", 
          RowBox[{"\"\<Binc\>\"", ",", 
           RowBox[{
           "\"\<Normalization\>\"", "->", "\"\<UnitTransmission\>\""}]}], 
          "]"}], "[", 
         RowBox[{
         "s", ",", "\[ScriptL]", ",", "m", ",", "a", ",", "\[Omega]", ",", 
          RowBox[{"{", 
           RowBox[{"\[Gamma]", ",", "order"}], "}"}]}], "]"}], "//", 
        "Normal"}], "//", 
       RowBox[{"ReplaceAll", "[", 
        RowBox[{"\[Gamma]", "->", "1"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"aux", "=", 
      RowBox[{
       RowBox[{"Quiet", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Log10", "[", 
               RowBox[{"1", "-", "a"}], "]"}], ",", 
              RowBox[{"Log10", "[", "\[Omega]", "]"}], ",", 
              RowBox[{"Log10", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  FractionBox[
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"TKR", "[", 
                    RowBox[{"\[Omega]", ",", "a"}], "]"}], "[", "\"\<In\>\"", 
                    "]"}], "[", "\"\<Amplitudes\>\"", "]"}], "[", 
                    "\"\<Incidence\>\"", "]"}], "Amp"], "-", "1"}], "//", 
                 "Abs"}], "//", 
                RowBox[{
                 RowBox[{"Min", "[", 
                  RowBox[{"#", ",", "1"}], "]"}], "&"}]}], "]"}]}], "}"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"\[Omega]", ",", "\[Omega]s"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"a", ",", "as"}], "}"}]}], "]"}], "]"}], "//", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"#", ",", "1"}], "]"}], "&"}]}]}], ";", 
     RowBox[{"plot", "=", 
      RowBox[{"aux", "//", 
       RowBox[{
        RowBox[{"ListDensityPlot", "[", 
         RowBox[{"#", ",", 
          RowBox[{"ColorFunction", "->", "\"\<DarkRainbow\>\""}], ",", 
          RowBox[{"MeshFunctions", "->", 
           RowBox[{"(", 
            RowBox[{"#3", "&"}], ")"}]}], ",", 
          RowBox[{"Mesh", "->", "True"}], ",", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{"BarLegend", "[", 
            RowBox[{"Automatic", ",", 
             RowBox[{
             "LegendLabel", "->", 
              "\"\<\!\(\*SubscriptBox[\(Log\), \(10\)]\) Relative \
Error\>\""}]}], "]"}]}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<1-a\>\"", ",", "\"\<\[Omega]\>\""}], "}"}]}], ",", 
          RowBox[{"FrameTicks", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"logTicks", ",", "None"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"logTicks", ",", "None"}], "}"}]}], "}"}]}]}], "]"}], 
        "&"}]}]}], ";", "\[IndentingNewLine]", "plot"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.992942178572603*^9, 3.99294232423717*^9}, {
   3.992942367863262*^9, 3.9929427895331287`*^9}, {3.992942859725031*^9, 
   3.992942913911456*^9}, {3.9929429515128937`*^9, 3.992942951886633*^9}, {
   3.992943240407943*^9, 3.992943426702766*^9}, {3.992943464397065*^9, 
   3.992943537096551*^9}, {3.9929435718767757`*^9, 3.992943580569138*^9}, {
