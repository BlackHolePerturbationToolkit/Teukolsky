Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c07ac740-56d0-48c5-bea0-3c5954706aa9"],
 "TeukolskyAmplitudePN[\"sol\"][\[ScriptS], \[ScriptL], \[ScriptM], a, \
\[Omega], {\[Gamma], n}] gives the desired PN expanded amplitude. Possible \
values for sol are as follows: A+, A-, Btrans, Binc, Bref, Ctrans, Cinc, \
Cref, K\[Nu], K-\[Nu]-1, K"
}], "Usage",
 CellChangeTimes->{{3.9746984109550657`*^9, 3.974698472579417*^9}, 
   3.974698573998959*^9},
 CellID->109357577,ExpressionUUID->"aab7ae03-4340-47ce-a2b1-06470465af40"],

