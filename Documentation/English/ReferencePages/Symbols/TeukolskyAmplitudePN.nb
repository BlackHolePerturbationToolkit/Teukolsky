Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TeukolskyAmplitudePN", "[", 
    RowBox[{"\"\<Btrans\>\"", ",", 
     RowBox[{"\"\<Normalization\>\"", "->", "\"\<SasakiTagoshi\>\""}]}], 
    "]"}], "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]", ",", "2"}], "}"}]}], "]"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.974699178556306*^9, 3.974699236700612*^9}},
 CellLabel->"In[26]:=",
 CellID->1115033394,ExpressionUUID->"f31205f1-b8c1-4046-9b09-07f53405afcc"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox[
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "a", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", 
           SuperscriptBox["a", "2"]}], "]"}], 
         RowBox[{"1", "+", 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}]]}]]}], ")"}]}]], 
    RowBox[{"16", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["a", "2"]}], ")"}], "2"]}]], "+", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "a", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"Log", "[", 
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}], "]"}], 
          RowBox[{"1", "+", 
           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["a", "2"]}]]}]]}], ")"}]}]], " ", "\[Omega]", " ", 
     RowBox[{"(", 
      RowBox[{"9", "+", 
       RowBox[{"10", " ", "\[ImaginaryI]", " ", "a"}], "+", 
       RowBox[{"24", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}]]}], "+", 
       RowBox[{"9", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}], "]"}]}]}], ")"}], " ", "\[Gamma]"}], 
    RowBox[{"144", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["a", "2"]}], ")"}], "2"]}]], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Gamma]", "]"}], "2"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 0, {
   Rational[1, 16] (-1 + $CellContext`a^2)^(-2) 
    E^(Complex[0, -1] $CellContext`a (
       1 + (1 + (1 - $CellContext`a^2)^Rational[1, 2])^(-1) 
        Log[1 - $CellContext`a^2])), Complex[0, 
      Rational[1, 144]] (-1 + $CellContext`a^2)^(-2) 
    E^(Complex[0, -1] $CellContext`a (
       1 + (1 + (1 - $CellContext`a^2)^Rational[1, 2])^(-1) 
        Log[1 - $CellContext`a^2])) $CellContext`\[Omega] (9 + 
     Complex[0, 10] $CellContext`a + 24 (1 - $CellContext`a^2)^Rational[1, 2] + 
     9 Log[1 - $CellContext`a^2])}, 0, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.974699232524495*^9, 3.9746992369996777`*^9}},
 CellLabel->"Out[26]=",
 CellID->1154900091,ExpressionUUID->"c96b8029-f9ef-4f65-b446-921941d3af7b"]
}, Open  ]],

Cell[TextData[{
 "In the \"Default\" normalization we divide ",
 Cell[BoxData[
  SubscriptBox["R", "In"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "59bb67ce-0459-46be-903c-87f77fa937c9"],
 " by ",
 Cell[BoxData[
  SubscriptBox["K", "\[Nu]"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "bc5b70e4-966c-4e13-890a-70efcffb38d5"],
 ". This also affects the amplitudes"
}], "ExampleText",
 CellChangeTimes->{{3.974699259969283*^9, 3.9746993122466373`*^9}},
 CellID->459201835,ExpressionUUID->"a3efe7d3-0295-40b7-8027-b4a8b05f18a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"default", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"TeukolskyAmplitudePN", "[", "\"\<Btrans\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
     RowBox[{"{", 
      RowBox[{"\[Gamma]", ",", "2"}], "}"}]}], "]"}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.974699454431321*^9, 3.974699464662928*^9}},
 CellLabel->"In[44]:=",
 CellID->1225020229,ExpressionUUID->"a68b1fcb-54ba-4667-a423-d7c5639f5cc4"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{
    FractionBox["4", "5"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "a", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", 
           SuperscriptBox["a", "2"]}], "]"}], 
         RowBox[{"1", "+", 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}]]}]]}], ")"}]}]], " ", 
    SuperscriptBox["\[Omega]", "4"], " ", 
    SuperscriptBox["\[Gamma]", "4"]}], "+", 
   RowBox[{
    FractionBox["4", "15"], " ", "\[ImaginaryI]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "a", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", 
           SuperscriptBox["a", "2"]}], "]"}], 
         RowBox[{"1", "+", 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}]]}]]}], ")"}]}]], " ", 
    SuperscriptBox["\[Omega]", "5"], " ", 
    RowBox[{"(", 
     RowBox[{"3", "+", 
      RowBox[{"7", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}]]}], "+", 
      RowBox[{"3", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}], "]"}]}], "+", 
      RowBox[{"6", " ", 
       RowBox[{"PolyGamma", "[", 
        RowBox[{"0", ",", 
         RowBox[{"3", "+", 
          FractionBox[
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], 
           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["a", "2"]}]]]}]}], "]"}]}]}], ")"}], " ", 
    SuperscriptBox["\[Gamma]", "5"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Gamma]", "]"}], "6"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 4, 6, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 0, {
   Rational[4, 5] 
    E^(Complex[0, -1] $CellContext`a (
       1 + (1 + (1 - $CellContext`a^2)^Rational[1, 2])^(-1) 
        Log[1 - $CellContext`a^2])) $CellContext`\[Omega]^4, Complex[0, 
      Rational[4, 15]] 
    E^(Complex[0, -1] $CellContext`a (
       1 + (1 + (1 - $CellContext`a^2)^Rational[1, 2])^(-1) 
        Log[1 - $CellContext`a^2])) $CellContext`\[Omega]^5 (3 + 
     7 (1 - $CellContext`a^2)^Rational[1, 2] + 3 Log[1 - $CellContext`a^2] + 
     6 PolyGamma[
       0, 3 + Complex[0, 2] $CellContext`a (1 - $CellContext`a^2)^
          Rational[-1, 2]])}, 4, 6, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.974699455182493*^9, 3.974699466271388*^9}},
 CellLabel->"Out[44]=",
 CellID->1474917011,ExpressionUUID->"93ace92b-18bc-44ee-8baa-2cc61dd5fbc7"]
}, Open  ]],

