Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TeukolskyAmplitudePN", "[", "\"\<Ctrans\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]", ",", "2"}], "}"}]}], "]"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.974698928254052*^9, 3.974698930030097*^9}},
 CellLabel->"In[11]:=",
 CellID->916470319,ExpressionUUID->"9cee7e3a-2e5b-49c5-a2e3-2bd24c3de322"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"-", 
    RowBox[{"2", " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Omega]", "3"], " ", 
     SuperscriptBox["\[Gamma]", "3"]}]}], "+", 
   RowBox[{
    FractionBox["2", "9"], " ", 
    SuperscriptBox["\[Omega]", "4"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "9"}], "-", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], "+", 
      RowBox[{"6", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}]]}], "+", 
      RowBox[{"9", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "+", 
      RowBox[{"18", " ", 
       RowBox[{"Log", "[", "2", "]"}]}], "+", 
      RowBox[{"18", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"2", " ", "\[Omega]"}], "]"}]}]}], ")"}], " ", 
    SuperscriptBox["\[Gamma]", "4"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Gamma]", "]"}], "5"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 3, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 0, {
   Complex[0, -2] $CellContext`\[Omega]^3, 
    Rational[2, 9] $CellContext`\[Omega]^4 (-9 + 
     Complex[0, -2] $CellContext`a + 6 (1 - $CellContext`a^2)^Rational[1, 2] + 
     Complex[0, 9] Pi + 18 Log[2] + 18 Log[2 $CellContext`\[Omega]])}, 3, 5, 
   1],
  Editable->False]], "Output",
 CellChangeTimes->{3.974698930532651*^9},
 CellLabel->"Out[11]=",
 CellID->1780643734,ExpressionUUID->"1ec5c289-f567-4438-b6ff-21788c068772"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TeukolskyAmplitudePN", "[", "\"\<K\[Nu]\>\"", "]"}], "[", 
   RowBox[{"0", ",", "0", ",", "0", ",", "a", ",", "\[Omega]", ",", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]", ",", "3"}], "}"}]}], "]"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.974698904085043*^9, 3.974698912848441*^9}, {
  3.974698949918092*^9, 3.974698951805521*^9}, {3.9746989878104*^9, 
  3.974698997055861*^9}},
 CellLabel->"In[22]:=",
 CellID->1644332744,ExpressionUUID->"1e141b79-5ee2-43f6-97b1-f53541025a4a"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox["9", "7"], "+", 
   RowBox[{
    FractionBox["3", "7"], " ", "\[ImaginaryI]", " ", 
    RowBox[{"(", 
     RowBox[{"4", "+", 
      RowBox[{"5", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}]]}], "+", 
      RowBox[{"6", " ", "EulerGamma"}]}], ")"}], " ", "\[Omega]", " ", 
    "\[Gamma]"}], "+", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"1715", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["a", "2"]}], ")"}]}]], 
    RowBox[{
     SuperscriptBox["\[Omega]", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"29896", "+", 
       RowBox[{"3532", " ", 
        SuperscriptBox["a", "4"]}], "+", 
       RowBox[{"4900", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}]]}], "-", 
       RowBox[{"4410", " ", "EulerGamma"}], "+", 
       RowBox[{"7350", " ", 
