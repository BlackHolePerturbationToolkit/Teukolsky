    RowBox[{"144", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["a", "2"]}], ")"}], "2"]}]], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Gamma]", "]"}], "2"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 0, {
   Rational[1, 16] (-1 + $CellContext`a^2)^(-2) 
    E^(Complex[0, -1] $CellContext`a (
       1 + (1 + (1 - $CellContext`a^2)^Rational[1, 2])^(-1) 
        Log[1 - $CellContext`a^2])), Complex[0, 
      Rational[1, 144]] (-1 + $CellContext`a^2)^(-2) 
    E^(Complex[0, -1] $CellContext`a (
       1 + (1 + (1 - $CellContext`a^2)^Rational[1, 2])^(-1) 
        Log[1 - $CellContext`a^2])) $CellContext`\[Omega] (9 + 
     Complex[0, 10] $CellContext`a + 24 (1 - $CellContext`a^2)^Rational[1, 2] + 
     9 Log[1 - $CellContext`a^2])}, 0, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.974699482430501*^9, 3.974699485666161*^9}},
 CellLabel->"Out[46]=",
 CellID->588080392,ExpressionUUID->"6e0ca5ec-f156-4674-8226-c655302b52f5"]
}, Open  ]],

