Cell[TextData[{
 "We can use TeukolskyAmplitudePN to compute e.g. ",
 Cell[BoxData[
  SubscriptBox["C", "trans"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "549bdbaf-9b54-4ce5-9665-2b49f6fe3af6"]
}], "ExampleText",
 CellChangeTimes->{{3.9937441849648743`*^9, 3.9937441988482437`*^9}},
 CellID->235453865,ExpressionUUID->"3bc8b447-2220-4f6d-b0df-7f4909cf18ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TeukolskyAmplitudePN", "[", "\"\<Ctrans\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]", ",", "2"}], "}"}]}], "]"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.974698928254052*^9, 3.974698930030097*^9}},
 CellLabel->"In[6]:=",
 CellID->916470319,ExpressionUUID->"9cee7e3a-2e5b-49c5-a2e3-2bd24c3de322"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"-", 
    RowBox[{"2", " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Omega]", "3"], " ", 
     SuperscriptBox["\[Gamma]", "3"]}]}], "+", 
   RowBox[{
    FractionBox["2", "9"], " ", 
    SuperscriptBox["\[Omega]", "4"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "9"}], "-", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], "+", 
      RowBox[{"6", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}]]}], "-", 
      RowBox[{"9", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "+", 
      RowBox[{"18", " ", 
       RowBox[{"Log", "[", "2", "]"}]}], "+", 
      RowBox[{"18", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"2", " ", "\[Omega]"}], "]"}]}]}], ")"}], " ", 
    SuperscriptBox["\[Gamma]", "4"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Gamma]", "]"}], "5"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 3, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 0, {
   Complex[0, -2] $CellContext`\[Omega]^3, 
    Rational[2, 9] $CellContext`\[Omega]^4 (-9 + 
