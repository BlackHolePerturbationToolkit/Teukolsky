Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\"FreqRep\"", "ExampleSubsection",ExpressionUUID->
   "59aacaa0-c858-4ae5-8bb1-585b6ff509a7"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->216066629,ExpressionUUID->"c048770b-32bd-40b0-8373-5c6aa67dff33"],

Cell[TextData[{
 "The amplitudes do not depend on the radial coordinate. This means that \
(going by the PN scalings ",
 Cell[BoxData[
  RowBox[{"\[Omega]", "~", 
   SuperscriptBox["\[Eta]", "3"]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "1b26890e-0d77-4414-b118-df28bf5dc461"],
 " and ",
 Cell[BoxData[
  RowBox[{"r", "~", 
   SuperscriptBox["\[Eta]", 
    RowBox[{"-", "2"}]]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "a3669ad1-b33c-48c0-9c7b-a0fc3cd9da4b"],
 ") they would always come in powers of ",
 Cell[BoxData[
  SuperscriptBox["\[Eta]", "3"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "e24b374d-2080-482e-b137-c60d40b1c333"],
 ". By default we thus count directly in powers of ",
 Cell[BoxData["\[Omega]"], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "3d528b56-cf88-41e6-9311-de8cfb0f36ea"],
 " instead of ",
 Cell[BoxData[
  SuperscriptBox["\[Omega]", 
   FractionBox["1", "3"]]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "f2638666-2ad8-4106-8493-6ca802a15e21"],
 ". The \"FreqRep\"  Option allows to disable this behavior  "
}], "ExampleText",
 CellChangeTimes->{{3.974699605935677*^9, 3.974699628977455*^9}, {
  3.974699662689919*^9, 3.974699796699436*^9}, {3.97469987823496*^9, 
  3.974699898636429*^9}},
 CellID->629816592,ExpressionUUID->"96f07635-c3ea-4daa-83b9-775d49f3b605"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TeukolskyAmplitudePN", "[", 
    RowBox[{"\"\<Ctrans\>\"", ",", 
     RowBox[{"\"\<FreqRep\>\"", "->", "False"}]}], "]"}], "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
    RowBox[{"{", 
     RowBox[{"\[Eta]", ",", "6"}], "}"}]}], "]"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.9746998385964127`*^9, 3.97469984871353*^9}},
 CellLabel->"In[56]:=",
 CellID->1344432071,ExpressionUUID->"acac182a-f95b-467d-8a75-e75dc12748c3"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"-", 
    RowBox[{"2", " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Omega]", "3"], " ", 
     SuperscriptBox["\[Eta]", "9"]}]}], "+", 
   RowBox[{
    FractionBox["2", "9"], " ", 
    SuperscriptBox["\[Omega]", "4"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "9"}], "-", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], "+", 
      RowBox[{"6", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}]]}], "+", 
      RowBox[{"9", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "+", 
      RowBox[{"18", " ", 
       RowBox[{"Log", "[", "2", "]"}]}], "+", 
      RowBox[{"18", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"2", " ", "\[Omega]"}], "]"}]}]}], ")"}], " ", 
    SuperscriptBox["\[Eta]", "12"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Eta]", "]"}], "15"],
    SeriesData[$CellContext`\[Eta], 0, {}, 9, 15, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Eta], 0, {
   Complex[0, -2] $CellContext`\[Omega]^3, 0, 0, 
    Rational[2, 9] $CellContext`\[Omega]^4 (-9 + 
     Complex[0, -2] $CellContext`a + 6 (1 - $CellContext`a^2)^Rational[1, 2] + 
     Complex[0, 9] Pi + 18 Log[2] + 18 Log[2 $CellContext`\[Omega]])}, 9, 15, 
   1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.974699840390328*^9, 3.9746998492870607`*^9}},
 CellLabel->"Out[56]=",
 CellID->666423142,ExpressionUUID->"0ff03600-0dd5-490f-a0a8-0823be88efb0"]
}, Open  ]],

