      RowBox[{"6", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}]]}], "-", 
      RowBox[{"9", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "+", 
      RowBox[{"18", " ", 
       RowBox[{"Log", "[", "2", "]"}]}], "+", 
      RowBox[{"18", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"2", " ", "\[Omega]"}], "]"}]}]}], ")"}], " ", 
    SuperscriptBox["\[Gamma]", "4"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Gamma]", "]"}], "5"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 3, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 0, {
