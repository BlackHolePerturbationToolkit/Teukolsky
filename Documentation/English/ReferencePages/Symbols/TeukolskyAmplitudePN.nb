Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TeukolskyAmplitudePN", "[", "\"\<Ctrans\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "a", ",", "\[Omega]", ",", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]", ",", "2"}], "}"}]}], "]"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.974698928254052*^9, 3.974698930030097*^9}},
 CellLabel->"In[11]:=",
 CellID->916470319,ExpressionUUID->"9cee7e3a-2e5b-49c5-a2e3-2bd24c3de322"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"-", 
    RowBox[{"2", " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Omega]", "3"], " ", 
     SuperscriptBox["\[Gamma]", "3"]}]}], "+", 
   RowBox[{
    FractionBox["2", "9"], " ", 
    SuperscriptBox["\[Omega]", "4"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "9"}], "-", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "a"}], "+", 
      RowBox[{"6", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}]]}], "+", 
      RowBox[{"9", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "+", 
      RowBox[{"18", " ", 
       RowBox[{"Log", "[", "2", "]"}]}], "+", 
      RowBox[{"18", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"2", " ", "\[Omega]"}], "]"}]}]}], ")"}], " ", 
    SuperscriptBox["\[Gamma]", "4"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Gamma]", "]"}], "5"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 3, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 0, {
   Complex[0, -2] $CellContext`\[Omega]^3, 
    Rational[2, 9] $CellContext`\[Omega]^4 (-9 + 
     Complex[0, -2] $CellContext`a + 6 (1 - $CellContext`a^2)^Rational[1, 2] + 
     Complex[0, 9] Pi + 18 Log[2] + 18 Log[2 $CellContext`\[Omega]])}, 3, 5, 
   1],
  Editable->False]], "Output",
 CellChangeTimes->{3.974698930532651*^9},
 CellLabel->"Out[11]=",
 CellID->1780643734,ExpressionUUID->"1ec5c289-f567-4438-b6ff-21788c068772"]
}, Open  ]],

