 CellLabel->"In[22]:=",
 CellID->1644332744,ExpressionUUID->"1e141b79-5ee2-43f6-97b1-f53541025a4a"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox["9", "7"], "+", 
   RowBox[{
    FractionBox["3", "7"], " ", "\[ImaginaryI]", " ", 
    RowBox[{"(", 
     RowBox[{"4", "+", 
      RowBox[{"5", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}]]}], "+", 
      RowBox[{"6", " ", "EulerGamma"}]}], ")"}], " ", "\[Omega]", " ", 
    "\[Gamma]"}], "+", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"1715", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["a", "2"]}], ")"}]}]], 
    RowBox[{
     SuperscriptBox["\[Omega]", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"29896", "+", 
       RowBox[{"3532", " ", 
        SuperscriptBox["a", "4"]}], "+", 
       RowBox[{"4900", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}]]}], "-", 
       RowBox[{"4410", " ", "EulerGamma"}], "+", 
       RowBox[{"7350", " ", 
