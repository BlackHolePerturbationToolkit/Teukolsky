Cell[CellGroupData[{

Cell["Checking against numerics", "ExampleSubsection",
 CellChangeTimes->{3.9747150631951523`*^9},
 CellID->1228005106,ExpressionUUID->"d7cda89e-1aa4-4c77-9d2e-92eabcc01c20"],

Cell["\<\
We numerically check against the toolkit. The output at the end of the cell \
is the relative error of real and imaginary part. Note that  in order to \
compare with the numerics we need to choose the \"UnitTransmission\" option \
for \"Normalization\". Feel free to change the values specified in the Module\
\
\>", "ExampleText",
 CellChangeTimes->{{3.9747151496650968`*^9, 3.974715162755101*^9}, {
  3.9747162486250877`*^9, 3.974716309333869*^9}, {3.974716354417869*^9, 
  3.974716372774441*^9}},
 CellID->2051354177,ExpressionUUID->"dbe850d1-812a-4e07-98b2-d9a3a314d67d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"amp", "=", "\"\<Cinc\>\""}], ",", 
     RowBox[{"\[ScriptS]", "=", 
      RowBox[{"-", "2"}]}], ",", 
     RowBox[{"\[ScriptL]", "=", "2"}], ",", 
     RowBox[{"\[ScriptM]", "=", "2"}], ",", 
     RowBox[{"\[ScriptA]", "=", ".3`64"}], ",", 
     RowBox[{"\[ScriptW]", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        SuperscriptBox["10", 
         RowBox[{"-", "3"}]], ",", "64"}], "]"}]}], ",", 
     RowBox[{"order", "=", "4"}], ",", "auxN", ",", "auxPN", ",", "testN", 
     ",", "testPN", ",", "boundary", ",", "sol", ",", "relError"}], "}"}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testPN", "=", 
     RowBox[{
      RowBox[{"TeukolskyAmplitudePN", "[", 
       RowBox[{"amp", ",", 
        RowBox[{"\"\<Normalization\>\"", "->", "\"\<UnitTransmission\>\""}]}],
        "]"}], "[", 
      RowBox[{
      "\[ScriptS]", ",", "\[ScriptL]", ",", "\[ScriptM]", ",", "a", ",", 
       "\[Omega]", ",", 
       RowBox[{"{", 
        RowBox[{"\[Gamma]", ",", "order"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"sol", "=", 
     RowBox[{"Switch", "[", 
      RowBox[{
      "amp", ",", "\"\<Btrans\>\"", ",", "\"\<Transmission\>\"", ",", 
       "\"\<Ctrans\>\"", ",", "\"\<Transmission\>\"", ",", "\"\<Binc\>\"", 
       ",", "\"\<Incidence\>\"", ",", "\"\<Cinc\>\"", ",", 
       "\"\<Incidence\>\"", ",", "\"\<Bref\>\"", ",", "\"\<Reflection\>\"", 
       ",", "\"\<Cref\>\"", ",", "\"\<Reflection\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"boundary", "=", 
     RowBox[{"Switch", "[", 
      RowBox[{
      "amp", ",", "\"\<Btrans\>\"", ",", "\"\<In\>\"", ",", "\"\<Ctrans\>\"", 
       ",", "\"\<Up\>\"", ",", "\"\<Binc\>\"", ",", "\"\<In\>\"", ",", 
       "\"\<Cinc\>\"", ",", "\"\<Up\>\"", ",", "\"\<Bref\>\"", ",", 
       "\"\<In\>\"", ",", "\"\<Cref\>\"", ",", "\"\<Up\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"testN", "=", 
     RowBox[{"TeukolskyRadial", "[", 
      RowBox[{
      "\[ScriptS]", ",", "\[ScriptL]", ",", "\[ScriptM]", ",", "\[ScriptA]", 
       ",", "\[ScriptW]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"auxN", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"testN", "[", "boundary", "]"}], "[", "\"\<Amplitudes\>\"", 
       "]"}], "[", "sol", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"auxPN", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"testPN", "//", "Normal"}], "//", 
       RowBox[{
        RowBox[{"ReplaceAll", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Gamma]", "->", "1"}], ",", 
            RowBox[{"a", "->", "\[ScriptA]"}], ",", 
            RowBox[{"\[Omega]", "->", "\[ScriptW]"}]}], "}"}]}], "]"}], 
        "&"}]}], "//", "Simplify"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"relError", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["auxPN", "auxN"], "-", "1"}], "//", "Simplify"}], "//", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"#", ",", "1"}], "]"}], "&"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Echo", "[", 
     RowBox[{"relError", ",", "\"\<Relative Error\>\""}], "]"}], ";"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.974619922159227*^9, 3.974620181825009*^9}, {
   3.974620226219508*^9, 3.974620226394236*^9}, {3.974621759816444*^9, 
   3.974621766340135*^9}, 3.974624085485877*^9, {3.974624824210481*^9, 
   3.974624824807678*^9}, {3.97463484867876*^9, 3.974634853868218*^9}, 
   3.974715217951536*^9, {3.974715263311572*^9, 3.9747153516117887`*^9}, {
   3.97471546331136*^9, 3.97471575441855*^9}, {3.974715788229534*^9, 
   3.9747158632347507`*^9}, {3.97471593795961*^9, 3.974716220925151*^9}, {
   3.9747163322909603`*^9, 3.974716343838251*^9}},
 CellLabel->"In[82]:=",
 CellID->2030892629,ExpressionUUID->"e9e360f5-aa57-4326-9505-54729d45b370"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Relative Error\"\>",
   "EchoLabel"], "  ", 
  RowBox[{
   RowBox[{"-", "2.01407133100611295607814440641`1.0886899877391278*^-9"}], 
   "-", 
   RowBox[{
   "1.15591323143530657444953009427`0.8475403751503958*^-9", " ", 
