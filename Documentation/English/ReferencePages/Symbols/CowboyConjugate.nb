  RowBox[{
   RowBox[{"Complex", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
   RowBox[{"Complex", "[", 
    RowBox[{"a", ",", 
     RowBox[{"-", "b"}]}], "]"}]}]}]], "Input",
